/// Chave PIX da própria empresa, distinta das chaves de fornecedor (`supplier_pix_keys`).
model CompanyPixKey {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid

  financialAccountId     String? @map("financial_account_id") @db.Uuid
  financialInstitutionId String? @map("financial_institution_id") @db.Uuid

  pixType       PixKeyType @map("pix_type")
  pixKey        String     @map("pix_key")
  /// Chave sem máscara. A unicidade é por empresa: duas empresas podem ter chaves
  /// distintas, mas a mesma chave não se repete dentro da mesma empresa.
  normalizedKey String     @map("normalized_key")

  holderName               String? @map("holder_name")
  holderDocument           String? @map("holder_document")
  normalizedHolderDocument String? @map("normalized_holder_document")

  purpose        PixKeyPurpose @default(GENERAL)
  isPrimary      Boolean       @default(false) @map("is_primary")
  isForBilling   Boolean       @default(false) @map("is_for_billing")
  isForSuppliers Boolean       @default(false) @map("is_for_suppliers")
  isForCustomers Boolean       @default(false) @map("is_for_customers")

  validationStatus BankDataVerificationStatus @default(UNVERIFIED) @map("validation_status")
  validatedAt      DateTime?                  @map("validated_at")
  status           RecordStatus               @default(ACTIVE)
  proofDocumentId  String?                    @map("proof_document_id") @db.Uuid
  notes            String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialAccount     FinancialAccount?     @relation(fields: [financialAccountId], references: [id])
  financialInstitution FinancialInstitution? @relation(fields: [financialInstitutionId], references: [id])

  @@unique([companyId, normalizedKey])
  @@index([organizationId])
  @@index([financialAccountId])
  @@map("company_pix_keys")
}

/// Permissões de um usuário **naquela conta**. O mesmo usuário pode ter alçadas
/// diferentes em contas diferentes, por isso o vínculo é por conta e não por perfil.
model FinancialAccountUser {
  id                 String  @id @default(uuid()) @db.Uuid
  financialAccountId String  @map("financial_account_id") @db.Uuid
  userId             String  @map("user_id") @db.Uuid
  roleId             String? @map("role_id") @db.Uuid

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  viewLimit        Decimal? @map("view_limit") @db.Decimal(18, 2)
  transactionLimit Decimal? @map("transaction_limit") @db.Decimal(18, 2)
  approvalLimit    Decimal? @map("approval_limit") @db.Decimal(18, 2)

  canViewBalance          Boolean @default(true) @map("can_view_balance")
  canViewBankData         Boolean @default(false) @map("can_view_bank_data")
  canCreateEntry          Boolean @default(false) @map("can_create_entry")
  canImportStatement      Boolean @default(false) @map("can_import_statement")
  canReconcile            Boolean @default(false) @map("can_reconcile")
  canSchedulePayment      Boolean @default(false) @map("can_schedule_payment")
