  TED
  DOC
  DIRECT_DEBIT
  CREDIT_CARD
  DEBIT_CARD
  CASH
  CHECK
  UTILITY_BILL
  COMPENSATION
  ACCOUNT_CREDIT
  BATCH_PAYMENT
  OTHER

  @@map("payment_method_type")
}

/// Meios de recebimento (seção 43).
enum ReceiptMethodType {
