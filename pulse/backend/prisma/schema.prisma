/// Cartão corporativo. Guarda apenas os quatro últimos dígitos — nunca o número
/// completo, o CVV ou a senha.
model CorporateCard {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid

  financialAccountId     String? @map("financial_account_id") @db.Uuid
  financialInstitutionId String? @map("financial_institution_id") @db.Uuid
  businessUnitId         String? @map("business_unit_id") @db.Uuid
  costCenterId           String? @map("cost_center_id") @db.Uuid
  defaultCategoryId      String? @map("default_category_id") @db.Uuid
  defaultProjectId       String? @map("default_project_id") @db.Uuid
  accountPlanId          String? @map("account_plan_id") @db.Uuid

  name        String
  displayName String? @map("display_name")

  cardType       CorporateCardType @map("card_type")
  brand          String?           @db.VarChar(40)
  /// Somente os quatro últimos dígitos, validados como exatamente 4 numerais.
  lastFourDigits String            @map("last_four_digits") @db.VarChar(4)

  holderName        String? @map("holder_name")
  responsibleUserId String? @map("responsible_user_id") @db.Uuid

  isPhysical Boolean @default(true) @map("is_physical")
  isVirtual  Boolean @default(false) @map("is_virtual")

  totalLimit       Decimal? @map("total_limit") @db.Decimal(18, 2)
  transactionLimit Decimal? @map("transaction_limit") @db.Decimal(18, 2)

  closingDay Int? @map("closing_day")
  dueDay     Int? @map("due_day")

  allowsInstallments  Boolean @default(true) @map("allows_installments")
  maximumInstallments Int?    @map("maximum_installments")

  issueDate      DateTime? @map("issue_date") @db.Date
  expirationDate DateTime? @map("expiration_date") @db.Date

  status CorporateCardStatus @default(DRAFT)
  notes  String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialAccount     FinancialAccount?     @relation(fields: [financialAccountId], references: [id])
  financialInstitution FinancialInstitution? @relation(fields: [financialInstitutionId], references: [id])
  businessUnit         BusinessUnit?         @relation(fields: [businessUnitId], references: [id])
  costCenter           CostCenter?           @relation(fields: [costCenterId], references: [id])
  defaultCategory      FinancialCategory?    @relation("CardDefaultCategory", fields: [defaultCategoryId], references: [id])
  defaultProject       Project?              @relation("CardDefaultProject", fields: [defaultProjectId], references: [id])
  accountPlan          FinancialAccountPlan? @relation("CardAccountPlan", fields: [accountPlanId], references: [id])

  users CorporateCardUser[]

  @@unique([companyId, financialInstitutionId, lastFourDigits, expirationDate])
  @@index([organizationId])
  @@index([companyId, status])
  @@map("corporate_cards")
}

