  defaultInterestCategory FinancialCategory? @relation("ReceiptMethodInterestCategory", fields: [defaultInterestCategoryId], references: [id])
  acquirerSupplier        Supplier?          @relation("ReceiptMethodAcquirer", fields: [acquirerSupplierId], references: [id])

  @@unique([organizationId, companyId, code])
  @@index([organizationId])
  @@map("receipt_methods")
