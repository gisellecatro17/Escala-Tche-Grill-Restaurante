// Pulse — schema de fundação + Cadastro de Empresas.
// Módulos financeiros (contas a pagar/receber, conciliação etc.) serão adicionados em etapas futuras.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("record_status")
}

/// Pessoa física ou jurídica.
enum PersonType {
  INDIVIDUAL
  LEGAL_ENTITY

  @@map("person_type")
}

/// Matriz, filial ou unidade operacional.
enum EstablishmentType {
  HEADQUARTERS
  BRANCH
  OPERATING_UNIT

  @@map("establishment_type")
}

/// Status interno da empresa no Pulse (distinto da situação cadastral externa/Receita).
enum CompanySystemStatus {
  DRAFT
  IMPLEMENTATION
  ACTIVE
  SUSPENDED
  INACTIVE
  CLOSED

  @@map("company_system_status")
}

/// Regime tributário.
enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
  IMUNE
  ISENTA
  OUTRO

  @@map("tax_regime")
}

/// Critério contábil/fiscal — usado tanto no regime de apuração fiscal quanto no
/// critério financeiro dos lançamentos.
enum AccountingCriterion {
  ACCRUAL
  CASH
  MIXED
  NOT_INFORMED

  @@map("accounting_criterion")
}

enum CompanyAddressType {
  FISCAL
  OPERATIONAL
  BILLING
  CORRESPONDENCE

  @@map("company_address_type")
}

enum CompanyContactType {
  PRIMARY
  FINANCIAL
  FISCAL
  ACCOUNTING
  ADMINISTRATIVE
  OPERATIONAL
  OTHER

  @@map("company_contact_type")
}

enum RegistryQueryStatus {
  SUCCESS
  ERROR

  @@map("registry_query_status")
}

// ── Cadastro de Fornecedores ────────────────────────────────────────────────

/// Pessoa física, jurídica ou fornecedor estrangeiro.
enum SupplierPersonType {
  INDIVIDUAL
  LEGAL_ENTITY
  FOREIGN

  @@map("supplier_person_type")
}

/// Status interno do cadastro global do fornecedor (distinto do status do vínculo por empresa).
enum SupplierSystemStatus {
  DRAFT
  PENDING_VALIDATION
  ACTIVE
  SUSPENDED
  INACTIVE

  @@map("supplier_system_status")
}

/// Status do vínculo de um fornecedor com uma empresa específica.
enum SupplierLinkStatus {
  DRAFT
  ACTIVE
  BLOCKED
  SUSPENDED
  INACTIVE

  @@map("supplier_link_status")
}

enum SupplierAddressType {
  FISCAL
  COMMERCIAL
  BILLING
  CORRESPONDENCE
  OPERATIONAL

  @@map("supplier_address_type")
}

/// Classificação do fornecedor quanto à natureza do que fornece (múltipla escolha, por vínculo).
enum SupplierType {
  MERCHANDISE
  SERVICE
  SERVICE_PROVIDER
  UTILITY_COMPANY
  TAX
  EMPLOYEE
  PARTNER
  FINANCIAL_INSTITUTION
  LANDLORD
  CARRIER
  GOVERNMENT_AGENCY
  FREELANCER
  OCCASIONAL_SUPPLIER
  OTHER

  @@map("supplier_type")
}

enum SupplierBankAccountType {
  CHECKING
  SAVINGS
  PAYMENT
  DIGITAL
  THIRD_PARTY
  OTHER

  @@map("supplier_bank_account_type")
}

enum PixKeyType {
  CPF
  CNPJ
  PHONE
  EMAIL
  RANDOM
  BANK_DATA

  @@map("pix_key_type")
}

enum BankDataVerificationStatus {
  UNVERIFIED
  VERIFIED
  FAILED

  @@map("bank_data_verification_status")
}

/// Status de aprovação de uma alteração de dado bancário/PIX. A estrutura já é criada
/// nesta etapa (seção 27 do prompt de fornecedores); o fluxo de dupla aprovação em si
/// será construído em etapa futura.
enum BankDataChangeStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED

  @@map("bank_data_change_status")
}

enum PaymentMethod {
  PIX
  BOLETO
  BANK_TRANSFER
  DIRECT_DEBIT
  CARD
  CASH
  CHECK
  OTHER

  @@map("payment_method")
}

enum FinancialNature {
  COST
  EXPENSE
  INVESTMENT
  TAX
  LOAN
  DISTRIBUTION
  REIMBURSEMENT
  ADVANCE
  TRANSFER
  OTHER

  @@map("financial_nature")
}

/// Política de retenção tributária do vínculo (seção 34).
enum TaxWithholdingPolicy {
  YES
  NO
  EVALUATE_PER_ENTRY

  @@map("tax_withholding_policy")
}

enum TaxWithholdingType {
  INSS
  IRRF
  ISS
  PIS
  COFINS
  CSLL
  OTHER

  @@map("tax_withholding_type")
}

enum AllocationType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("allocation_type")
}

enum SupplierContractStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
  CANCELLED
  EXPIRED

  @@map("supplier_contract_status")
}

// ── Cadastro de Clientes ────────────────────────────────────────────────────

/// Pessoa física, jurídica ou cliente estrangeiro.
enum CustomerPersonType {
  INDIVIDUAL
  LEGAL_ENTITY
  FOREIGN

  @@map("customer_person_type")
}

/// Status interno do cadastro geral do cliente (distinto do status do vínculo por empresa).
enum CustomerSystemStatus {
  DRAFT
  PENDING_VALIDATION
  ACTIVE
  SUSPENDED
  INACTIVE

  @@map("customer_system_status")
}

/// Status do vínculo de um cliente com uma empresa — inclui PROSPECT, já que prospect e
/// cliente compartilham o mesmo cadastro geral (seção 64 do prompt de clientes).
enum CustomerLinkStatus {
  PROSPECT
  DRAFT
  ACTIVE
  BLOCKED
  SUSPENDED
  INACTIVE

  @@map("customer_link_status")
}

/// Status financeiro do vínculo — separado do status cadastral (seção 41).
enum CustomerFinancialStatus {
  ON_TIME
  ATTENTION
  OVERDUE
  DELINQUENT
  NEGOTIATING
  BLOCKED
  SUSPENDED
  NO_ACTIVITY

  @@map("customer_financial_status")
}

enum CustomerAddressType {
  FISCAL
  BILLING
  DELIVERY
  OPERATIONAL
  CORRESPONDENCE

  @@map("customer_address_type")
}

enum AbcClassification {
  A
  B
  C
  NOT_CLASSIFIED

  @@map("abc_classification")
}

enum RevenuePotentialLevel {
  LOW
  MEDIUM
  HIGH
  STRATEGIC

  @@map("revenue_potential_level")
}

enum CustomerRiskLevel {
  VERY_LOW
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  NOT_ASSESSED

  @@map("customer_risk_level")
}

/// Periodicidade de faturamento/recorrência (seção 31).
enum RecurrencePeriodicity {
  ONCE
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM

  @@map("recurrence_periodicity")
}

enum CustomerPaymentMethod {
  PIX
  BOLETO
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  CASH
  DIRECT_DEBIT
  PAYMENT_LINK
  CHECK
  OTHER

  @@map("customer_payment_method")
}

enum CustomerOrigin {
  REFERRAL
  ACTIVE_PROSPECTING
  WEBSITE
  SOCIAL_MEDIA
  EVENT
  PARTNER
  CAMPAIGN
  OLD_CUSTOMER
  SYSTEM_MIGRATION
  OTHER

  @@map("customer_origin")
}

/// Classificação do cliente quanto ao tipo (múltipla escolha, por vínculo).
enum CustomerType {
  INDIVIDUAL
  PRIVATE_COMPANY
  GOVERNMENT_AGENCY
  AUTARCHY
  FOUNDATION
  ASSOCIATION
  CONDOMINIUM
  COOPERATIVE
  INDUSTRY
  COMMERCE
  SERVICE_PROVIDER
  ECONOMIC_GROUP
  INTERNAL_CUSTOMER
  OTHER

  @@map("customer_type")
}

enum AdjustmentType {
  ECONOMIC_INDEX
  FIXED_PERCENTAGE
  FIXED_AMOUNT
  MANUAL_NEGOTIATION
  NONE

  @@map("adjustment_type")
}

enum CustomerContractStatus {
  DRAFT
  NEGOTIATING
  PENDING_SIGNATURE
  ACTIVE
  SUSPENDED
  CLOSED
  CANCELLED
  EXPIRED

  @@map("customer_contract_status")
}

enum PaymentPromiseStatus {
  OPEN
  FULFILLED
  PARTIALLY_FULFILLED
  NOT_FULFILLED
  CANCELLED
  RENEGOTIATED

  @@map("payment_promise_status")
}

enum CollectionChannel {
  EMAIL
  WHATSAPP
  SMS
  INTERNAL_NOTIFICATION
  MANUAL_CALL
  LETTER
  OTHER

  @@map("collection_channel")
}

/// Status de processamento da recorrência — permanece `PENDING_FINANCIAL_MODULE` até o
/// módulo de contas a receber existir (seção 84 do prompt de clientes).
enum RecurrenceProcessingStatus {
  PENDING_FINANCIAL_MODULE
  ACTIVE
  PAUSED
  FINISHED

  @@map("recurrence_processing_status")
}

// ─────────────────────────────────────────────────────────────────────────────
// Estrutura Financeira (plano de contas, categorias, centros, projetos, tags)
// ─────────────────────────────────────────────────────────────────────────────

/// Grupo/tipo da conta na árvore do plano de contas.
enum AccountPlanType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST
  EXPENSE
  RESULT
  COMPENSATION
  TRANSFER
  OTHER

  @@map("account_plan_type")
}

/// Conta sintética (agrupadora, não aceita lançamentos) x analítica (folha, aceita).
enum AccountKind {
  SYNTHETIC
  ANALYTICAL

  @@map("account_kind")
}

/// Tipo da natureza financeira do catálogo (`financial_natures`). Não confundir com o
/// enum `FinancialNature`, que continua atendendo o vínculo de fornecedor já entregue.
enum FinancialNatureKind {
  OPERATING_REVENUE
  NON_OPERATING_REVENUE
  FINANCIAL_REVENUE
  DIRECT_COST
  INDIRECT_COST
  OPERATING_EXPENSE
  ADMINISTRATIVE_EXPENSE
  COMMERCIAL_EXPENSE
  FINANCIAL_EXPENSE
  REVENUE
  EXPENSE
  COST
  INVESTMENT
  TAX
  TRANSFER
  ADVANCE
  REIMBURSEMENT
  LOAN
  FINANCING
  FINANCIAL_APPLICATION
  REDEMPTION
  CAPITAL_CONTRIBUTION
  PROFIT_DISTRIBUTION
  PARTNER_WITHDRAWAL
  ADJUSTMENT
  OTHER

  @@map("financial_nature_kind")
}

/// Ciclo de vida de um projeto.
enum ProjectStatus {
  DRAFT
  PLANNING
  IN_APPROVAL
  IN_PROGRESS
  PAUSED
  DELAYED
  COMPLETED
  CANCELLED
  ARCHIVED

  @@map("project_status")
}

/// Critério de rateio (seção "Rateios" do prompt de estrutura financeira).
enum AllocationCriterion {
  PERCENTAGE
  FIXED_AMOUNT
  QUANTITY
  HOURS
  WEIGHT
  AREA
  CONSUMPTION
  CUSTOM

  @@map("allocation_criterion")
}

/// Dimensão de destino de uma linha de rateio.
enum AllocationTargetType {
  COST_CENTER
  RESULT_CENTER
  PROJECT
  BUSINESS_UNIT
  CATEGORY
  ACCOUNT_PLAN

  @@map("allocation_target_type")
}

/// Forma de comparação usada por uma regra de classificação automática.
enum ClassificationMatchType {
  CONTAINS
  EQUALS
  STARTS_WITH
  ENDS_WITH
  REGEX
  AMOUNT_RANGE
  DOCUMENT_NUMBER

  @@map("classification_match_type")
}

/// Campo do lançamento importado sobre o qual a regra é aplicada.
enum ClassificationMatchField {
  DESCRIPTION
  COUNTERPARTY_NAME
  COUNTERPARTY_DOCUMENT
  BANK_HISTORY
  AMOUNT
  DOCUMENT_NUMBER

  @@map("classification_match_field")
}

/// Origem do lançamento a que a regra se aplica (preparação para OFX/PIX/cartão).
enum TransactionOrigin {
  ANY
  OFX
  PIX
  TED
  DOC
  BOLETO
  CARD
  CASH
  MANUAL
  PDF_DOCUMENT
  INVOICE
  XML
  SPREADSHEET
  INTEGRATION

  @@map("transaction_origin")
}

/// Como a regra de classificação nasceu — `LEARNED` é reservado ao motor futuro.
enum ClassificationRuleSource {
  MANUAL
  IMPORTED
  LEARNED
  SYSTEM

  @@map("classification_rule_source")
}

/// Cadastro cuja árvore/estrutura foi versionada.
enum HierarchyEntity {
  ACCOUNT_PLAN
  CATEGORY
  COST_CENTER
  RESULT_CENTER
  BUSINESS_UNIT
  PROJECT

  @@map("hierarchy_entity")
}

/// Formato de origem aceito na importação da estrutura financeira.
enum StructureImportFormat {
  XLSX
  EXCEL
  CSV
  JSON
  CONTA_AZUL
  OMIE
  SAP
  TOTVS
  SANKHYA
  BLING
  CUSTOM

  @@map("structure_import_format")
}

/// Situação de um lote de importação da estrutura financeira.
enum StructureImportStatus {
  PENDING
  VALIDATED
  APPLIED
  REJECTED
  FAILED

  @@map("structure_import_status")
}

/// Status padronizado dos cadastros da estrutura financeira (seção 49). Enum próprio para
/// não alterar `RecordStatus`, que é compartilhado com empresas, fornecedores e clientes.
enum StructureStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("structure_status")
}

/// Finalidade do plano de contas (seção 10).
enum AccountPlanKind {
  MANAGEMENT
  FINANCIAL
  ACCOUNTING
  HYBRID

  @@map("account_plan_kind")
}

/// Ciclo de vida de uma versão do plano de contas (seção 14).
enum AccountPlanVersionStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  SUPERSEDED
  ARCHIVED

  @@map("account_plan_version_status")
}

/// Tipo da categoria financeira (seção 15.2).
enum FinancialCategoryType {
  REVENUE
  EXPENSE
  COST
  INVESTMENT
  TRANSFER
  NEUTRAL

  @@map("financial_category_type")
}

/// Agrupamento da natureza financeira (seção 61).
enum FinancialNatureGroup {
  REVENUE
  COST
  EXPENSE
  INVESTMENT
  TAX
  FINANCIAL
  EQUITY
  TRANSFER
  ADJUSTMENT
  OTHER

  @@map("financial_nature_group")
}

/// Efeito de uma natureza sobre caixa, resultado ou patrimônio (seções 32-33).
enum NatureEffect {
  INCREASE
  DECREASE
  NONE

  @@map("nature_effect")
}

/// Sentido do fluxo financeiro de uma natureza.
enum FlowDirection {
  INFLOW
  OUTFLOW
  BOTH
  NONE

  @@map("flow_direction")
}

/// Prioridade de um projeto (seção 27.2).
enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("project_priority")
}

/// Tipo de unidade de negócio (seção 31).
enum BusinessUnitType {
  OPERATIONAL_UNIT
  MANAGEMENT_BRANCH
  BUSINESS_LINE
  DEPARTMENT
  CHANNEL
  PRODUCT
  SERVICE
  OTHER

  @@map("business_unit_type")
}

/// Escopo de aplicação de uma tag financeira (seção 34).
enum TagScope {
  ORGANIZATION
  COMPANY
  SUPPLIER
  CUSTOMER
  ENTRY
  CONTRACT
  PROJECT
  RECONCILIATION
  DOCUMENT

  @@map("tag_scope")
}

/// Campo do lançamento avaliado por uma condição de regra (seção 36).
enum RuleConditionField {
  DOCUMENT_NUMBER
  CNPJ
  CPF
  SUPPLIER
  CUSTOMER
  KEYWORD
  DESCRIPTION
  BANK_HISTORY
  PIX_KEY
  BANK_ACCOUNT
  BANK
  TRANSACTION_TYPE
  AMOUNT
  DATE
  WEEKDAY
  DAY_OF_MONTH
  COMPANY_BANK_ACCOUNT
  CONTRACT
  PROJECT
  ORIGIN
  PREVIOUS_CATEGORY
  CONFIRMATION_COUNT

  @@map("rule_condition_field")
}

/// Operador de comparação de uma condição de regra (seção 36).
enum RuleConditionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  NOT_CONTAINS
  STARTS_WITH
  ENDS_WITH
  REGEX
  GREATER_THAN
  LESS_THAN
  BETWEEN
  IN
  NOT_IN
  EXISTS
  NOT_EXISTS

  @@map("rule_condition_operator")
}

/// Modo de aplicação de uma importação (seção 44).
enum StructureImportMode {
  INSERT_ONLY
  UPDATE_ONLY
  INSERT_AND_UPDATE
  SIMULATE

  @@map("structure_import_mode")
}

/// Resultado da validação de uma linha importada (seção 43).
enum ImportRowStatus {
  VALID
  WARNING
  ERROR

  @@map("import_row_status")
}

/// Severidade de uma inconsistência detectada pelo diagnóstico (seção 48).
enum DiagnosticSeverity {
  CRITICAL
  WARNING
  INFO

  @@map("diagnostic_severity")
}

/// Cliente/grupo contratante da plataforma Pulse. Pode possuir várias empresas (CNPJs).
model Organization {
  id     String       @id @default(uuid()) @db.Uuid
  name   String
  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  companies               Company[]
  userMemberships         UserOrganizationRole[]
  auditLogs               AuditLog[]
  companyRegistryQueries  CompanyRegistryQuery[]
  suppliers               Supplier[]
  supplierRegistryQueries SupplierRegistryQuery[]
  customers               Customer[]
  customerRegistryQueries CustomerRegistryQuery[]

  accountPlans        FinancialAccountPlan[]
  financialNatures    FinancialNatureCatalog[]
  businessUnits       BusinessUnit[]
  financialTags       FinancialTag[]
  hierarchyVersions   FinancialHierarchyVersion[]
  accountPlanVersions FinancialAccountPlanVersion[]
  hierarchyHistory    FinancialHierarchyHistory[]
  structureImports    FinancialStructureImport[]
  financialAccounts   FinancialAccount[]
  companyPixKeys      CompanyPixKey[]
  corporateCards      CorporateCard[]
  paymentMethods      PaymentMethodCatalog[]
  receiptMethods      ReceiptMethod[]
  treasurySettings    TreasurySettings[]

  intakeDocuments        IntakeDocument[]
  intakeBatchImports     IntakeBatchImport[]
  documentIntakeSettings DocumentIntakeSettings[]

  @@map("organizations")
}

/// Uma empresa (CNPJ/CPF, matriz/filial/unidade) pertencente a uma organização.
/// Unidade principal de operação financeira: todo registro operacional futuro
/// (fornecedores, clientes, contas, lançamentos etc.) deverá se vincular a uma empresa.
model Company {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  parentCompanyId String? @map("parent_company_id") @db.Uuid
  internalCode    String? @map("internal_code")

  // Identificação
  // documentNumber/normalizedDocumentNumber/legalName/displayName são opcionais no banco
  // para permitir salvar rascunhos incompletos (seção 10 do prompt mestre); a completude
  // desses campos é exigida pelas regras de negócio antes da ativação (seção 31).
  personType               PersonType @default(LEGAL_ENTITY) @map("person_type")
  documentNumber           String?    @map("document_number")
  normalizedDocumentNumber String?    @unique @map("normalized_document_number")
  legalName                String?    @map("legal_name")
  tradeName                String?    @map("trade_name")
  displayName              String?    @map("display_name")

  establishmentType EstablishmentType @default(HEADQUARTERS) @map("establishment_type")

  externalRegistrationStatus     String?             @map("external_registration_status")
  externalRegistrationStatusDate DateTime?           @map("external_registration_status_date")
  systemStatus                   CompanySystemStatus @default(DRAFT) @map("system_status")

  logoUrl                 String?   @map("logo_url")
  implementationStartDate DateTime? @map("implementation_start_date")
  deactivationReason      String?   @map("deactivation_reason")
  suspensionReason        String?   @map("suspension_reason")
  registrationNotes       String?   @map("registration_notes")

  // Dados cadastrais
  openingDate           DateTime? @map("opening_date")
  legalNature           String?   @map("legal_nature")
  companySize           String?   @map("company_size")
  shareCapital          Decimal?  @map("share_capital") @db.Decimal(18, 2)
  stateRegistration     String?   @map("state_registration")
  municipalRegistration String?   @map("municipal_registration")
  mainCnae              String?   @map("main_cnae")

  // Contatos gerais
  email          String?
  phone          String?
  phoneSecondary String? @map("phone_secondary")
  whatsapp       String?
  emailFinancial String? @map("email_financial")
  emailFiscal    String? @map("email_fiscal")
  website        String?

  // Informações fiscais
  taxRegime                    TaxRegime?           @map("tax_regime")
  taxAssessmentMethod          AccountingCriterion? @map("tax_assessment_method")
  icmsTaxpayer                 Boolean?             @map("icms_taxpayer")
  simplesNacionalOptant        Boolean?             @map("simples_nacional_optant")
  simplesNacionalOptionDate    DateTime?            @map("simples_nacional_option_date")
  simplesNacionalExclusionDate DateTime?            @map("simples_nacional_exclusion_date")
  specialTaxRegime             String?              @map("special_tax_regime")
  accountingFirmName           String?              @map("accounting_firm_name")
  accountingResponsibleName    String?              @map("accounting_responsible_name")
  taxNotes                     String?              @map("tax_notes")

  // Configurações financeiras
  currencyCode            String              @default("BRL") @map("currency_code")
  dateFormat              String              @default("DD/MM/YYYY") @map("date_format")
  timezone                String              @default("America/Bahia")
  financialMethod         AccountingCriterion @default(ACCRUAL) @map("financial_method")
  financialMonthStartDay  Int                 @default(1) @map("financial_month_start_day")
  monthClosingDay         Int                 @default(31) @map("month_closing_day")
  allowRetroactiveEntries Boolean             @default(true) @map("allow_retroactive_entries")
  allowFutureEntries      Boolean             @default(true) @map("allow_future_entries")
  requiresCategory        Boolean             @default(true) @map("requires_category")
  requiresCostCenter      Boolean             @default(false) @map("requires_cost_center")
  requiresSupplier        Boolean             @default(false) @map("requires_supplier")
  requiresCustomer        Boolean             @default(false) @map("requires_customer")
  requiresAttachment      Boolean             @default(false) @map("requires_attachment")
  requiresApproval        Boolean             @default(false) @map("requires_approval")
  approvalLevels          Int                 @default(1) @map("approval_levels")
  automaticCodeEnabled    Boolean             @default(true) @map("automatic_code_enabled")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  parentCompany Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  branches      Company[] @relation("CompanyHierarchy")

  addresses       CompanyAddress[]
  contacts        CompanyContact[]
  cnaes           CompanyCnae[]
  registryQueries CompanyRegistryQuery[]
  statusHistory   CompanyStatusHistory[]
  userMemberships UserCompanyRole[]
  auditLogs       AuditLog[]
  supplierLinks   SupplierCompanyLink[]
  customerLinks   CustomerCompanyLink[]
  categories      FinancialCategory[]
  costCenters     CostCenter[]

  accountPlans        FinancialAccountPlan[]
  resultCenters       ResultCenter[]
  projects            Project[]
  businessUnits       BusinessUnit[]
  financialNatures    FinancialNatureCatalog[]
  financialTags       FinancialTag[]
  classificationRules ClassificationRule[]
  allocationRules     AllocationRule[]
  hierarchyVersions   FinancialHierarchyVersion[]
  accountPlanVersions FinancialAccountPlanVersion[]
  hierarchyHistory    FinancialHierarchyHistory[]
  structureImports    FinancialStructureImport[]
  financialAccounts   FinancialAccount[]
  companyPixKeys      CompanyPixKey[]
  corporateCards      CorporateCard[]
  paymentMethods      PaymentMethodCatalog[]
  receiptMethods      ReceiptMethod[]
  treasurySettings    TreasurySettings?

  intakeDocuments        IntakeDocument[]
  intakeBatchImports     IntakeBatchImport[]
  documentIntakeSettings DocumentIntakeSettings?

  @@unique([organizationId, internalCode])
  @@index([organizationId])
  @@index([parentCompanyId])
  @@index([systemStatus])
  @@map("companies")
}

/// Endereço de uma empresa (fiscal, operacional, cobrança, correspondência).
model CompanyAddress {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  addressType          CompanyAddressType @map("address_type")
  postalCode           String             @map("postal_code")
  normalizedPostalCode String             @map("normalized_postal_code")
  street               String
  number               String?
  complement           String?
  district             String?
  city                 String
  state                String
  country              String             @default("BR")
  cityCode             String?            @map("city_code")
  reference            String?
  isPrimary            Boolean            @default(false) @map("is_primary")
  sameAsAddressId      String?            @map("same_as_address_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sameAsAddress CompanyAddress?  @relation("CompanyAddressCopy", fields: [sameAsAddressId], references: [id])
  copiedBy      CompanyAddress[] @relation("CompanyAddressCopy")

  @@index([companyId])
  @@map("company_addresses")
}

/// Responsável/contato de uma empresa.
model CompanyContact {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  contactType CompanyContactType @map("contact_type")
  name        String
  position    String?
  department  String?
  phone       String?
  whatsapp    String?
  email       String?
  isPrimary   Boolean            @default(false) @map("is_primary")
  status      RecordStatus       @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_contacts")
}

/// CNAE (principal ou secundário) de uma empresa.
model CompanyCnae {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  cnaeCode    String  @map("cnae_code")
  description String?
  isMain      Boolean @default(false) @map("is_main")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cnaeCode])
  @@index([companyId])
  @@map("company_cnaes")
}

/// Histórico de consultas cadastrais (CNPJ/CPF) via provider externo desacoplado.
model CompanyRegistryQuery {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid

  documentNumber  String              @map("document_number")
  provider        String
  requestStatus   RegistryQueryStatus @map("request_status")
  responseSummary Json?               @map("response_summary")
  queriedBy       String?             @map("queried_by") @db.Uuid
  queriedAt       DateTime            @default(now()) @map("queried_at")
  errorCode       String?             @map("error_code")
  errorMessage    String?             @map("error_message")

  organization Organization? @relation(fields: [organizationId], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id])

  @@index([documentNumber])
  @@index([companyId])
  @@map("company_registry_queries")
}

/// Histórico de mudanças do status interno da empresa (ativação/inativação/suspensão...).
model CompanyStatusHistory {
  id             String               @id @default(uuid()) @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  previousStatus CompanySystemStatus? @map("previous_status")
  newStatus      CompanySystemStatus  @map("new_status")
  reason         String?
  changedBy      String?              @map("changed_by") @db.Uuid
  changedAt      DateTime             @default(now()) @map("changed_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_status_history")
}

/// Perfil de usuário do Pulse. O id é o mesmo id do usuário em auth.users (Supabase Auth).
model User {
  id        String       @id @db.Uuid
  name      String
  email     String       @unique
  phone     String?
  avatarUrl String?      @map("avatar_url")
  status    RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organizationMemberships UserOrganizationRole[]
  companyMemberships      UserCompanyRole[]
  auditLogs               AuditLog[]
  financialAccountLinks   FinancialAccountUser[]
  corporateCardLinks      CorporateCardUser[]

  @@map("users")
}

/// Perfil (conjunto de permissões) que pode ser atribuído a um usuário.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String?
  /// Perfis do sistema (não podem ser excluídos ou renomeados pelo cliente).
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions             RolePermission[]
  organizationMemberships UserOrganizationRole[]
  companyMemberships      UserCompanyRole[]
  financialAccountUsers   FinancialAccountUser[]

  @@map("roles")
}

/// Permissão granular (ex.: "payables.approve", "company.view").
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  module      String
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Vínculo de um usuário a uma organização com um perfil (ex.: Administrador da organização).
model UserOrganizationRole {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("user_organization_roles")
}

/// Vínculo de um usuário a uma empresa com um perfil (o mesmo usuário pode ter perfis
/// diferentes em empresas diferentes), incluindo alçadas e permissões operacionais finas.
model UserCompanyRole {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  roleId    String       @map("role_id") @db.Uuid
  status    RecordStatus @default(ACTIVE)

  approvalLimit     Decimal?  @map("approval_limit") @db.Decimal(18, 2)
  canViewBankData   Boolean   @default(false) @map("can_view_bank_data")
  canImportOfx      Boolean   @default(false) @map("can_import_ofx")
  canReconcile      Boolean   @default(false) @map("can_reconcile")
  canViewReports    Boolean   @default(false) @map("can_view_reports")
  canManageSettings Boolean   @default(false) @map("can_manage_settings")
  startDate         DateTime? @map("start_date")
  endDate           DateTime? @map("end_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_company_roles")
}

/// Registro de auditoria — somente leitura para usuários comuns.
model AuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid
  userId         String? @map("user_id") @db.Uuid

  action   String
  entity   String
  entityId String? @map("entity_id") @db.Uuid
  field    String?
  oldValue Json?   @map("old_value")
  newValue Json?   @map("new_value")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  origin    String?
  reason    String?

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([companyId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Cadastro de Fornecedores / Cadastro de Clientes ─────────────────────────
// Estrutura mínima reutilizável de categorias e centros de custo financeiros
// (seção 29 do prompt de fornecedores) — escopo restrito ao necessário para a
// classificação padrão de fornecedores e clientes; o módulo completo de
// categorias/centros de custo/resultado fica para etapa futura. O Cadastro de
// Clientes reaproveita as mesmas tabelas para "categoria de receita" e "centro
// de resultado" (seção 25 do prompt de clientes) em vez de criar catálogos
// paralelos — ver docs/arquitetura.md.

/// Categoria financeira mínima, com suporte a subcategorias (parentCategoryId).
/// Reaproveitada tanto como categoria de despesa (fornecedores) quanto como
/// categoria de receita (clientes).
/// Categoria financeira. As **subcategorias** são a própria hierarquia deste model
/// (`parentCategoryId`), e não uma tabela separada: os módulos de Fornecedores e Clientes
/// já apontam `defaultSubcategoryId` para `categories.id`, de modo que uma tabela
/// `financial_subcategories` paralela duplicaria o conceito e órfãos essas FKs.
/// Profundidade ilimitada (categoria → subcategoria → sub-subcategoria → ...).
model FinancialCategory {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  parentCategoryId String?      @map("parent_category_id") @db.Uuid
  name             String
  status           RecordStatus @default(ACTIVE)

  // ── Identificação e apresentação ──
  code           String?               @db.VarChar(50)
  description    String?
  normalizedCode String?               @map("normalized_code") @db.VarChar(50)
  shortName      String?               @map("short_name") @db.VarChar(60)
  categoryType   FinancialCategoryType @default(EXPENSE) @map("category_type")

  // ── Obrigatoriedades exigidas no lançamento (seção 17) ──
  requiresSubcategory  Boolean @default(false) @map("requires_subcategory")
  requiresCostCenter   Boolean @default(false) @map("requires_cost_center")
  requiresResultCenter Boolean @default(false) @map("requires_result_center")
  requiresProject      Boolean @default(false) @map("requires_project")
  requiresBusinessUnit Boolean @default(false) @map("requires_business_unit")
  requiresSupplier     Boolean @default(false) @map("requires_supplier")
  requiresCustomer     Boolean @default(false) @map("requires_customer")
  requiresDocument     Boolean @default(false) @map("requires_document")
  requiresAttachment   Boolean @default(false) @map("requires_attachment")

  allowsAllocation   Boolean @default(true) @map("allows_allocation")
  requiresAllocation Boolean @default(false) @map("requires_allocation")
  allowsBudget       Boolean @default(true) @map("allows_budget")

  showInCashFlow        Boolean @default(true) @map("show_in_cash_flow")
  showInIncomeStatement Boolean @default(true) @map("show_in_income_statement")
  showInReports         Boolean @default(true) @map("show_in_reports")

  /// Forma de recebimento padrão, distinta da forma de pagamento.
  defaultReceiptMethod PaymentMethod? @map("default_receipt_method")

  lastUsedAt      DateTime?       @map("last_used_at")
  structureStatus StructureStatus @default(ACTIVE) @map("structure_status")
  color           String?         @db.VarChar(20)
  icon            String?         @db.VarChar(50)
  sortOrder       Int             @default(0) @map("sort_order")
  notes           String?

  /// Profundidade na árvore (0 = raiz). Mantida pelo serviço para acelerar consultas.
  level Int     @default(0)
  /// Caminho materializado dos ancestrais (ex.: "Despesas > Energia"), recalculado ao mover.
  path  String?

  /// Categoria de sistema — protegida contra exclusão pelo usuário.
  isSystem Boolean @default(false) @map("is_system")

  // ── Vínculos estruturais (dimensões padrão herdadas pelos lançamentos) ──
  accountPlanId         String? @map("account_plan_id") @db.Uuid
  financialNatureId     String? @map("financial_nature_id") @db.Uuid
  defaultCostCenterId   String? @map("default_cost_center_id") @db.Uuid
  defaultResultCenterId String? @map("default_result_center_id") @db.Uuid
  defaultProjectId      String? @map("default_project_id") @db.Uuid
  defaultBusinessUnitId String? @map("default_business_unit_id") @db.Uuid

  // ── Regras automáticas da categoria ──
  defaultSupplierId       String?        @map("default_supplier_id") @db.Uuid
  defaultCustomerId       String?        @map("default_customer_id") @db.Uuid
  /// Conta bancária padrão — FK lógica; o módulo de contas bancárias da empresa ainda não existe.
  defaultBankAccountId    String?        @map("default_bank_account_id") @db.Uuid
  defaultPaymentMethod    PaymentMethod? @map("default_payment_method")
  /// Conta gerencial em texto livre (não há plano contábil contábil-fiscal separado nesta etapa).
  managementAccount       String?        @map("management_account")
  defaultDescription      String?        @map("default_description")
  defaultHistory          String?        @map("default_history")
  /// Rateio padrão aplicado automaticamente aos lançamentos desta categoria.
  defaultAllocationRuleId String?        @map("default_allocation_rule_id") @db.Uuid

  /// Habilita a sugestão/aplicação automática desta categoria na importação bancária.
  autoClassificationEnabled Boolean @default(true) @map("auto_classification_enabled")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentCategory FinancialCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subcategories  FinancialCategory[] @relation("CategoryHierarchy")

  accountPlan           FinancialAccountPlan?   @relation("CategoryAccountPlan", fields: [accountPlanId], references: [id])
  financialNature       FinancialNatureCatalog? @relation("CategoryFinancialNature", fields: [financialNatureId], references: [id])
  defaultCostCenter     CostCenter?             @relation("CategoryDefaultCostCenter", fields: [defaultCostCenterId], references: [id])
  defaultResultCenter   ResultCenter?           @relation("CategoryDefaultResultCenter", fields: [defaultResultCenterId], references: [id])
  defaultProject        Project?                @relation("CategoryDefaultProject", fields: [defaultProjectId], references: [id])
  defaultBusinessUnit   BusinessUnit?           @relation("CategoryDefaultBusinessUnit", fields: [defaultBusinessUnitId], references: [id])
  defaultAllocationRule AllocationRule?         @relation("CategoryDefaultAllocationRule", fields: [defaultAllocationRuleId], references: [id])

  defaultForLinks    SupplierCompanyLink[] @relation("LinkDefaultCategory")
  defaultSubForLinks SupplierCompanyLink[] @relation("LinkDefaultSubcategory")

  defaultRevenueForLinks    CustomerCompanyLink[] @relation("CustomerLinkDefaultRevenueCategory")
  defaultRevenueSubForLinks CustomerCompanyLink[] @relation("CustomerLinkDefaultSubcategory")
  defaultForContracts       CustomerContract[]    @relation("ContractRevenueCategory")

  classificationRules      ClassificationRule[]
  allocationRules          AllocationRule[]           @relation("AllocationRuleCategory")
  allocationLines          AllocationRuleItem[]       @relation("AllocationLineCategory")
  tagLinks                 FinancialTagLink[]         @relation("CategoryTagLinks")
  ruleActionsAsCategory    ClassificationRuleAction[] @relation("RuleActionCategory")
  ruleActionsAsSubcategory ClassificationRuleAction[] @relation("RuleActionSubcategory")
  cardsAsDefault           CorporateCard[]            @relation("CardDefaultCategory")
  paymentMethodFees        PaymentMethodCatalog[]     @relation("PaymentMethodFeeCategory")
  receiptMethodFees        ReceiptMethod[]            @relation("ReceiptMethodFeeCategory")
  receiptMethodInterests   ReceiptMethod[]            @relation("ReceiptMethodInterestCategory")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, parentCategoryId])
  @@index([accountPlanId])
  @@map("financial_categories")
}

/// Centro de custo, com árvore de profundidade ilimitada. O Cadastro de Clientes ainda
/// aponta seu "centro de resultado" para este model (decisão da etapa anterior); o model
/// `ResultCenter` abaixo é a estrutura definitiva e separada exigida por este módulo.
model CostCenter {
  id                 String       @id @default(uuid()) @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  parentCostCenterId String?      @map("parent_cost_center_id") @db.Uuid
  name               String
  status             RecordStatus @default(ACTIVE)

  code        String? @db.VarChar(50)
  description String?
  color       String? @db.VarChar(20)
  icon        String? @db.VarChar(50)
  sortOrder   Int     @default(0) @map("sort_order")
  notes       String?
  level       Int     @default(0)
  path        String?

  /// Somente centros analíticos (folhas) aceitam lançamentos diretos.
  acceptsEntries    Boolean   @default(true) @map("accepts_entries")
  isSystem          Boolean   @default(false) @map("is_system")
  responsibleUserId String?   @map("responsible_user_id") @db.Uuid
  normalizedCode    String?   @map("normalized_code") @db.VarChar(50)
  /// Organização dona do centro — redundante com a empresa, mas exigida pela seção 57.
  organizationId    String?   @map("organization_id") @db.Uuid
  businessUnitId    String?   @map("business_unit_id") @db.Uuid
  managerUserId     String?   @map("manager_user_id") @db.Uuid
  startDate         DateTime? @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  budgetAmount      Decimal?  @map("budget_amount") @db.Decimal(18, 2)

  lastUsedAt      DateTime?       @map("last_used_at")
  structureStatus StructureStatus @default(ACTIVE) @map("structure_status")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentCostCenter CostCenter?   @relation("CostCenterHierarchy", fields: [parentCostCenterId], references: [id])
  businessUnit     BusinessUnit? @relation("CostCenterBusinessUnit", fields: [businessUnitId], references: [id])
  children         CostCenter[]  @relation("CostCenterHierarchy")

  links         SupplierCompanyLink[]
  customerLinks CustomerCompanyLink[]
  contracts     CustomerContract[]

  defaultForCategories FinancialCategory[]        @relation("CategoryDefaultCostCenter")
  projects             Project[]                  @relation("ProjectCostCenter")
  classificationRules  ClassificationRule[]
  allocationLines      AllocationRuleItem[]       @relation("AllocationLineCostCenter")
  tagLinks             FinancialTagLink[]         @relation("CostCenterTagLinks")
  ruleActions          ClassificationRuleAction[] @relation("RuleActionCostCenter")
  financialAccounts    FinancialAccount[]
  corporateCards       CorporateCard[]
  cardUsers            CorporateCardUser[]        @relation("CardUserCostCenter")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, parentCostCenterId])
  @@map("cost_centers")
}

/// Catálogo de instituições financeiras (bancos), reutilizável por outros módulos futuros.
model FinancialInstitution {
  id        String       @id @default(uuid()) @db.Uuid
  compeCode String?      @map("compe_code")
  ispb      String?
  legalName String       @map("legal_name")
  shortName String?      @map("short_name")
  status    RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bankAccounts      SupplierBankAccount[]
  financialAccounts FinancialAccount[]
  companyPixKeys    CompanyPixKey[]
  corporateCards    CorporateCard[]

  @@unique([compeCode])
  @@index([ispb])
  @@index([legalName])
  @@map("financial_institutions")
}

/// Cadastro global do fornecedor (identidade fiscal/cadastral) — não deve ser duplicado
/// por CPF/CNPJ. Cada empresa que utiliza este fornecedor possui seu próprio vínculo
/// (SupplierCompanyLink) com configurações independentes.
model Supplier {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  personType     SupplierPersonType @default(LEGAL_ENTITY) @map("person_type")

  documentNumber           String? @map("document_number")
  normalizedDocumentNumber String? @unique @map("normalized_document_number")
  legalName                String? @map("legal_name")
  tradeName                String? @map("trade_name")
  displayName              String? @map("display_name")

  stateRegistration     String?   @map("state_registration")
  municipalRegistration String?   @map("municipal_registration")
  openingDate           DateTime? @map("opening_date")
  legalNature           String?   @map("legal_nature")
  companySize           String?   @map("company_size")
  shareCapital          Decimal?  @map("share_capital") @db.Decimal(18, 2)

  externalRegistrationStatus     String?   @map("external_registration_status")
  externalRegistrationStatusDate DateTime? @map("external_registration_status_date")
  mainCnae                       String?   @map("main_cnae")
  countryCode                    String    @default("BR") @map("country_code")
  segment                        String?

  // Pessoa estrangeira (seção 13)
  foreignTaxId    String? @map("foreign_tax_id")
  foreignCountry  String? @map("foreign_country")
  foreignCurrency String? @map("foreign_currency")

  systemStatus SupplierSystemStatus @default(DRAFT) @map("system_status")
  generalNotes String?              @map("general_notes")

  // Contatos gerais (seção 21)
  phone                String?
  whatsapp             String?
  email                String?
  emailFinancial       String? @map("email_financial")
  emailPaymentReceipts String? @map("email_payment_receipts")
  website              String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  addresses                SupplierAddress[]
  contacts                 SupplierContact[]
  cnaes                    SupplierCnae[]
  alternativeNames         SupplierAlternativeName[]
  bankAccounts             SupplierBankAccount[]
  pixKeys                  SupplierPixKey[]
  bankIdentifiers          SupplierBankIdentifier[]
  companyLinks             SupplierCompanyLink[]
  registryQueries          SupplierRegistryQuery[]
  statusHistory            SupplierStatusHistory[]
  primaryForProjects       Project[]                 @relation("ProjectPrimarySupplier")
  receiptMethodsAsAcquirer ReceiptMethod[]           @relation("ReceiptMethodAcquirer")
  intakeDocuments          IntakeDocument[]

  @@index([organizationId])
  @@index([systemStatus])
  @@map("suppliers")
}

/// Endereço do fornecedor (fiscal, comercial, cobrança, correspondência, operacional).
model SupplierAddress {
  id         String @id @default(uuid()) @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid

  addressType          SupplierAddressType @map("address_type")
  postalCode           String              @map("postal_code")
  normalizedPostalCode String              @map("normalized_postal_code")
  street               String
  number               String?
  complement           String?
  district             String?
  city                 String
  state                String
  country              String              @default("BR")
  cityCode             String?             @map("city_code")
  reference            String?
  isPrimary            Boolean             @default(false) @map("is_primary")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_addresses")
}

/// Contato do fornecedor.
model SupplierContact {
  id         String @id @default(uuid()) @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid

  name                    String
  position                String?
  department              String?
  phone                   String?
  whatsapp                String?
  email                   String?
  isPrimary               Boolean      @default(false) @map("is_primary")
  isFinancialContact      Boolean      @default(false) @map("is_financial_contact")
  isCommercialContact     Boolean      @default(false) @map("is_commercial_contact")
  isInvoiceResponsible    Boolean      @default(false) @map("is_invoice_responsible")
  isBillingResponsible    Boolean      @default(false) @map("is_billing_responsible")
  receivesPaymentReceipts Boolean      @default(false) @map("receives_payment_receipts")
  status                  RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  supplier  Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  contracts SupplierContract[]

  @@index([supplierId])
  @@map("supplier_contacts")
}

/// CNAE (principal ou secundário) do fornecedor.
model SupplierCnae {
  id          String  @id @default(uuid()) @db.Uuid
  supplierId  String  @map("supplier_id") @db.Uuid
  cnaeCode    String  @map("cnae_code")
  description String?
  isMain      Boolean @default(false) @map("is_main")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, cnaeCode])
  @@index([supplierId])
  @@map("supplier_cnaes")
}

/// Nome alternativo pelo qual o fornecedor pode ser reconhecido (seção 39) — usado
/// futuramente para identificação automática em extratos bancários.
model SupplierAlternativeName {
  id             String @id @default(uuid()) @db.Uuid
  supplierId     String @map("supplier_id") @db.Uuid
  name           String
  normalizedName String @map("normalized_name")

  createdAt DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_alternative_names")
}

/// Conta bancária do fornecedor. Pode ser de titularidade de terceiro, mediante
/// justificativa (seção 24).
model SupplierBankAccount {
  id                     String  @id @default(uuid()) @db.Uuid
  supplierId             String  @map("supplier_id") @db.Uuid
  financialInstitutionId String? @map("financial_institution_id") @db.Uuid

  branchNumber                String                     @map("branch_number")
  branchDigit                 String?                    @map("branch_digit")
  accountNumber               String                     @map("account_number")
  accountDigit                String?                    @map("account_digit")
  normalizedAccountIdentifier String?                    @map("normalized_account_identifier")
  accountType                 SupplierBankAccountType    @map("account_type")
  holderName                  String                     @map("holder_name")
  holderDocument              String                     @map("holder_document")
  normalizedHolderDocument    String                     @map("normalized_holder_document")
  isPrimary                   Boolean                    @default(false) @map("is_primary")
  isThirdParty                Boolean                    @default(false) @map("is_third_party")
  thirdPartyReason            String?                    @map("third_party_reason")
  thirdPartyApprovedBy        String?                    @map("third_party_approved_by") @db.Uuid
  thirdPartyApprovedAt        DateTime?                  @map("third_party_approved_at")
  verificationStatus          BankDataVerificationStatus @default(UNVERIFIED) @map("verification_status")
  changeStatus                BankDataChangeStatus       @default(NOT_REQUIRED) @map("change_status")
  status                      RecordStatus               @default(ACTIVE)
  proofDocumentId             String?                    @map("proof_document_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  financialInstitution FinancialInstitution? @relation(fields: [financialInstitutionId], references: [id])
  pixKeys              SupplierPixKey[]

  @@index([supplierId])
  @@map("supplier_bank_accounts")
}

/// Chave PIX do fornecedor.
model SupplierPixKey {
  id            String  @id @default(uuid()) @db.Uuid
  supplierId    String  @map("supplier_id") @db.Uuid
  bankAccountId String? @map("bank_account_id") @db.Uuid

  pixType                  PixKeyType                 @map("pix_type")
  pixKey                   String                     @map("pix_key")
  normalizedKey            String                     @unique @map("normalized_key")
  holderName               String                     @map("holder_name")
  holderDocument           String                     @map("holder_document")
  normalizedHolderDocument String                     @map("normalized_holder_document")
  isPrimary                Boolean                    @default(false) @map("is_primary")
  isThirdParty             Boolean                    @default(false) @map("is_third_party")
  thirdPartyReason         String?                    @map("third_party_reason")
  verificationStatus       BankDataVerificationStatus @default(UNVERIFIED) @map("verification_status")
  changeStatus             BankDataChangeStatus       @default(NOT_REQUIRED) @map("change_status")
  status                   RecordStatus               @default(ACTIVE)
  proofDocumentId          String?                    @map("proof_document_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  bankAccount SupplierBankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([supplierId])
  @@map("supplier_pix_keys")
}

/// Identificador bancário aprendido/cadastrado para reconhecimento futuro do fornecedor em
/// extratos (OFX), boletos e comprovantes (seção 38). Nesta etapa apenas a estrutura de
/// dados é criada — o motor de reconhecimento automático fica para etapa futura.
model SupplierBankIdentifier {
  id         String  @id @default(uuid()) @db.Uuid
  supplierId String  @map("supplier_id") @db.Uuid
  companyId  String? @map("company_id") @db.Uuid

  identifierType  String
  identifierValue String       @map("identifier_value")
  normalizedValue String       @map("normalized_value")
  source          String?
  priority        Int          @default(100)
  confidence      Decimal?     @db.Decimal(5, 2)
  confirmedCount  Int          @default(0) @map("confirmed_count")
  rejectedCount   Int          @default(0) @map("rejected_count")
  lastConfirmedAt DateTime?    @map("last_confirmed_at")
  status          RecordStatus @default(ACTIVE)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([normalizedValue])
  @@map("supplier_bank_identifiers")
}

/// Vínculo de um fornecedor global com uma empresa — cada empresa possui sua própria
/// classificação financeira, condições comerciais, retenções, rateios e automações
/// (seção 3.2 do prompt de fornecedores).
model SupplierCompanyLink {
  id         String @id @default(uuid()) @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid
  companyId  String @map("company_id") @db.Uuid

  internalCode  String?        @map("internal_code")
  supplierTypes SupplierType[] @map("supplier_types")

  defaultCategoryId        String?          @map("default_category_id") @db.Uuid
  defaultSubcategoryId     String?          @map("default_subcategory_id") @db.Uuid
  defaultCostCenterId      String?          @map("default_cost_center_id") @db.Uuid
  defaultAccountingAccount String?          @map("default_accounting_account")
  defaultDescription       String?          @map("default_description")
  defaultHistory           String?          @map("default_history")
  financialNature          FinancialNature? @map("financial_nature")
  categoryRequired         Boolean          @default(false) @map("category_required")
  costCenterRequired       Boolean          @default(false) @map("cost_center_required")

  preferredPaymentMethod       PaymentMethod? @map("preferred_payment_method")
  paymentTermDays              Int?           @map("payment_term_days")
  paymentTermFixedDueDay       Int?           @map("payment_term_fixed_due_day")
  paymentTermPeriodicity       String?        @map("payment_term_periodicity")
  preferredBankAccountId       String?        @map("preferred_bank_account_id") @db.Uuid
  preferredPixKeyId            String?        @map("preferred_pix_key_id") @db.Uuid
  minimumAmount                Decimal?       @map("minimum_amount") @db.Decimal(18, 2)
  maximumAmountWithoutApproval Decimal?       @map("maximum_amount_without_approval") @db.Decimal(18, 2)

  hasContract                 Boolean @default(false) @map("has_contract")
  requiresMatchingBeneficiary Boolean @default(true) @map("requires_matching_beneficiary")
  allowsThirdPartyPayment     Boolean @default(false) @map("allows_third_party_payment")

  taxWithholdingPolicy TaxWithholdingPolicy? @map("tax_withholding_policy")
  allocationEnabled    Boolean               @default(false) @map("allocation_enabled")

  // Regras automáticas (seção 36-37) — apenas preferências/estrutura nesta etapa.
  autoIdentificationEnabled       Boolean @default(true) @map("auto_identification_enabled")
  autoClassificationEnabled       Boolean @default(true) @map("auto_classification_enabled")
  autoCostCenterEnabled           Boolean @default(true) @map("auto_cost_center_enabled")
  autoAllocationEnabled           Boolean @default(true) @map("auto_allocation_enabled")
  reconciliationSuggestionEnabled Boolean @default(true) @map("reconciliation_suggestion_enabled")
  autoEntryCreationEnabled        Boolean @default(false) @map("auto_entry_creation_enabled")
  autoReconciliationEnabled       Boolean @default(false) @map("auto_reconciliation_enabled")
  confirmationThreshold           Decimal @default(95) @map("confirmation_threshold") @db.Decimal(5, 2)

  status           SupplierLinkStatus @default(DRAFT)
  blockReason      String?            @map("block_reason")
  suspensionReason String?            @map("suspension_reason")
  internalNotes    String?            @map("internal_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  supplier           Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultCategory    FinancialCategory? @relation("LinkDefaultCategory", fields: [defaultCategoryId], references: [id])
  defaultSubcategory FinancialCategory? @relation("LinkDefaultSubcategory", fields: [defaultSubcategoryId], references: [id])
  defaultCostCenter  CostCenter?        @relation(fields: [defaultCostCenterId], references: [id])

  classificationRules SupplierClassificationRule[]
  allocations         SupplierDefaultAllocation[]
  taxWithholdings     SupplierTaxWithholding[]
  contracts           SupplierContract[]
  statusHistory       SupplierStatusHistory[]

  @@unique([supplierId, companyId])
  @@index([companyId])
  @@index([supplierId])
  @@map("supplier_company_links")
}

/// Regra de classificação automática alternativa por condição (seção 31).
model SupplierClassificationRule {
  id                    String @id @default(uuid()) @db.Uuid
  supplierCompanyLinkId String @map("supplier_company_link_id") @db.Uuid

  ruleType             String?
  conditionField       String       @map("condition_field")
  conditionOperator    String       @map("condition_operator")
  conditionValue       String       @map("condition_value")
  normalizedValue      String?      @map("normalized_value")
  categoryId           String?      @map("category_id") @db.Uuid
  subcategoryId        String?      @map("subcategory_id") @db.Uuid
  costCenterId         String?      @map("cost_center_id") @db.Uuid
  priority             Int          @default(100)
  confidence           Decimal?     @db.Decimal(5, 2)
  automatic            Boolean      @default(false)
  requiresConfirmation Boolean      @default(true) @map("requires_confirmation")
  status               RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  link SupplierCompanyLink @relation(fields: [supplierCompanyLinkId], references: [id], onDelete: Cascade)

  @@index([supplierCompanyLinkId])
  @@map("supplier_classification_rules")
}

/// Item de rateio padrão do vínculo (seção 35).
model SupplierDefaultAllocation {
  id                    String @id @default(uuid()) @db.Uuid
  supplierCompanyLinkId String @map("supplier_company_link_id") @db.Uuid

  categoryId     String?        @map("category_id") @db.Uuid
  costCenterId   String?        @map("cost_center_id") @db.Uuid
  allocationType AllocationType @map("allocation_type")
  percentage     Decimal?       @db.Decimal(5, 2)
  fixedAmount    Decimal?       @map("fixed_amount") @db.Decimal(18, 2)
  priority       Int            @default(100)
  status         RecordStatus   @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  link SupplierCompanyLink @relation(fields: [supplierCompanyLinkId], references: [id], onDelete: Cascade)

  @@index([supplierCompanyLinkId])
  @@map("supplier_default_allocations")
}

/// Retenção tributária padrão do vínculo (seção 34) — funciona como sugestão, podendo ser
/// alterada em cada lançamento futuro.
model SupplierTaxWithholding {
  id                    String @id @default(uuid()) @db.Uuid
  supplierCompanyLinkId String @map("supplier_company_link_id") @db.Uuid

  taxType              TaxWithholdingType @map("tax_type")
  rate                 Decimal?           @db.Decimal(5, 2)
  minimumAmount        Decimal?           @map("minimum_amount") @db.Decimal(18, 2)
  calculationBase      String?            @map("calculation_base")
  serviceCode          String?            @map("service_code")
  cityCode             String?            @map("city_code")
  revenueCode          String?            @map("revenue_code")
  automatic            Boolean            @default(false)
  requiresConfirmation Boolean            @default(true) @map("requires_confirmation")
  notes                String?
  status               RecordStatus       @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  link SupplierCompanyLink @relation(fields: [supplierCompanyLinkId], references: [id], onDelete: Cascade)

  @@index([supplierCompanyLinkId])
  @@map("supplier_tax_withholdings")
}

/// Contrato do fornecedor com a empresa (seção 43).
model SupplierContract {
  id                    String @id @default(uuid()) @db.Uuid
  supplierCompanyLinkId String @map("supplier_company_link_id") @db.Uuid

  contractNumber        String?                @map("contract_number")
  description           String?
  object                String?
  contractValue         Decimal?               @map("contract_value") @db.Decimal(18, 2)
  startDate             DateTime?              @map("start_date")
  endDate               DateTime?              @map("end_date")
  automaticRenewal      Boolean                @default(false) @map("automatic_renewal")
  billingFrequency      String?                @map("billing_frequency")
  adjustmentIndex       String?                @map("adjustment_index")
  adjustmentDate        DateTime?              @map("adjustment_date")
  internalResponsibleId String?                @map("internal_responsible_id") @db.Uuid
  supplierContactId     String?                @map("supplier_contact_id") @db.Uuid
  status                SupplierContractStatus @default(DRAFT)
  notes                 String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  link            SupplierCompanyLink @relation(fields: [supplierCompanyLinkId], references: [id], onDelete: Cascade)
  supplierContact SupplierContact?    @relation(fields: [supplierContactId], references: [id])

  @@index([supplierCompanyLinkId])
  @@map("supplier_contracts")
}

/// Histórico de consultas cadastrais (CPF/CNPJ) de fornecedores via provider externo
/// desacoplado — reaproveita o mesmo provider do Cadastro de Empresas.
model SupplierRegistryQuery {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  supplierId     String? @map("supplier_id") @db.Uuid

  documentNumber  String              @map("document_number")
  provider        String
  requestStatus   RegistryQueryStatus @map("request_status")
  responseSummary Json?               @map("response_summary")
  queriedBy       String?             @map("queried_by") @db.Uuid
  queriedAt       DateTime            @default(now()) @map("queried_at")
  errorCode       String?             @map("error_code")
  errorMessage    String?             @map("error_message")

  organization Organization? @relation(fields: [organizationId], references: [id])
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])

  @@index([documentNumber])
  @@index([supplierId])
  @@map("supplier_registry_queries")
}

/// Histórico de mudanças de status — tanto do cadastro global quanto de um vínculo
/// específico com uma empresa (bloqueio, desbloqueio, ativação, inativação, suspensão).
model SupplierStatusHistory {
  id                    String   @id @default(uuid()) @db.Uuid
  supplierId            String?  @map("supplier_id") @db.Uuid
  supplierCompanyLinkId String?  @map("supplier_company_link_id") @db.Uuid
  previousStatus        String?  @map("previous_status")
  newStatus             String   @map("new_status")
  reason                String?
  changedBy             String?  @map("changed_by") @db.Uuid
  changedAt             DateTime @default(now()) @map("changed_at")

  supplier Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  link     SupplierCompanyLink? @relation(fields: [supplierCompanyLinkId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([supplierCompanyLinkId])
  @@map("supplier_status_history")
}

/// Base de aprendizado para reconhecimento futuro de fornecedores a partir de descrições
/// bancárias confirmadas manualmente (seção 42). Nesta etapa apenas a estrutura de dados e
/// os serviços de registro são criados — nenhuma decisão autônoma é tomada a partir dela.
model SupplierRecognitionLearning {
  id                    String  @id @default(uuid()) @db.Uuid
  organizationId        String? @map("organization_id") @db.Uuid
  companyId             String? @map("company_id") @db.Uuid
  supplierId            String? @map("supplier_id") @db.Uuid
  supplierCompanyLinkId String? @map("supplier_company_link_id") @db.Uuid

  originalText    String       @map("original_text")
  normalizedText  String       @map("normalized_text")
  sourceType      String?      @map("source_type")
  categoryId      String?      @map("category_id") @db.Uuid
  costCenterId    String?      @map("cost_center_id") @db.Uuid
  confirmedCount  Int          @default(0) @map("confirmed_count")
  rejectedCount   Int          @default(0) @map("rejected_count")
  confidence      Decimal?     @db.Decimal(5, 2)
  lastConfirmedBy String?      @map("last_confirmed_by") @db.Uuid
  lastConfirmedAt DateTime?    @map("last_confirmed_at")
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([supplierId])
  @@map("supplier_recognition_learning")
}

/// Estrutura genérica de anexos, reutilizável por qualquer entidade do sistema
/// (fornecedor, vínculo, conta bancária, chave PIX, contrato...) via entityType/entityId.
model Attachment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid

  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id") @db.Uuid
  documentType   String?      @map("document_type")
  fileName       String       @map("file_name")
  storagePath    String       @map("storage_path")
  mimeType       String?      @map("mime_type")
  fileSize       Int?         @map("file_size")
  issueDate      DateTime?    @map("issue_date")
  expirationDate DateTime?    @map("expiration_date")
  status         RecordStatus @default(ACTIVE)
  notes          String?
  uploadedBy     String?      @map("uploaded_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  intakeDocumentFiles IntakeDocumentFile[]

  @@index([entityType, entityId])
  @@map("attachments")
}

// ── Cadastro de Clientes ────────────────────────────────────────────────────

/// Cadastro geral do cliente (identidade fiscal/cadastral) — não deve ser duplicado por
/// CPF/CNPJ. Prospects e clientes ativos compartilham este mesmo cadastro (seção 64 do
/// prompt de clientes); cada empresa que se relaciona com ele possui seu próprio vínculo
/// (CustomerCompanyLink) com classificação comercial e financeira independente.
model Customer {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  personType     CustomerPersonType @default(LEGAL_ENTITY) @map("person_type")

  documentNumber           String? @map("document_number")
  normalizedDocumentNumber String? @unique @map("normalized_document_number")
  legalName                String? @map("legal_name")
  tradeName                String? @map("trade_name")
  displayName              String? @map("display_name")

  stateRegistration     String?   @map("state_registration")
  municipalRegistration String?   @map("municipal_registration")
  openingDate           DateTime? @map("opening_date")
  birthDate             DateTime? @map("birth_date")
  legalNature           String?   @map("legal_nature")
  companySize           String?   @map("company_size")
  shareCapital          Decimal?  @map("share_capital") @db.Decimal(18, 2)

  externalRegistrationStatus     String?   @map("external_registration_status")
  externalRegistrationStatusDate DateTime? @map("external_registration_status_date")
  mainCnae                       String?   @map("main_cnae")
  countryCode                    String    @default("BR") @map("country_code")
  preferredLanguage              String?   @map("preferred_language")
  segment                        String?

  // Pessoa estrangeira (seção 13)
  foreignDocument String? @map("foreign_document")
  billingCurrency String? @map("billing_currency")

  systemStatus CustomerSystemStatus @default(DRAFT) @map("system_status")
  generalNotes String?              @map("general_notes")

  // Contatos gerais (seção 23)
  phone          String?
  whatsapp       String?
  email          String?
  emailFinancial String? @map("email_financial")
  emailBilling   String? @map("email_billing")
  emailFiscal    String? @map("email_fiscal")
  website        String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  addresses               CustomerAddress[]
  contacts                CustomerContact[]
  cnaes                   CustomerCnae[]
  bankIdentifiers         CustomerBankIdentifier[]
  companyLinks            CustomerCompanyLink[]
  registryQueries         CustomerRegistryQuery[]
  statusHistory           CustomerStatusHistory[]
  projects                Project[]                @relation("ProjectCustomer")
  primaryForResultCenters ResultCenter[]           @relation("ResultCenterPrimaryCustomer")
  intakeDocuments         IntakeDocument[]

  @@index([organizationId])
  @@index([systemStatus])
  @@map("customers")
}

/// Endereço do cliente (fiscal, cobrança, entrega, operacional, correspondência).
model CustomerAddress {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  addressType          CustomerAddressType @map("address_type")
  postalCode           String              @map("postal_code")
  normalizedPostalCode String              @map("normalized_postal_code")
  street               String
  number               String?
  complement           String?
  district             String?
  city                 String
  state                String
  country              String              @default("BR")
  cityCode             String?             @map("city_code")
  reference            String?
  isPrimary            Boolean             @default(false) @map("is_primary")
  sameAsAddressId      String?             @map("same_as_address_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sameAsAddress CustomerAddress?  @relation("CustomerAddressCopy", fields: [sameAsAddressId], references: [id])
  copiedBy      CustomerAddress[] @relation("CustomerAddressCopy")

  @@index([customerId])
  @@map("customer_addresses")
}

/// Contato do cliente.
model CustomerContact {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  name                 String
  position             String?
  department           String?
  phone                String?
  whatsapp             String?
  email                String?
  isPrimary            Boolean      @default(false) @map("is_primary")
  isFinancialContact   Boolean      @default(false) @map("is_financial_contact")
  isBillingContact     Boolean      @default(false) @map("is_billing_contact")
  isContractContact    Boolean      @default(false) @map("is_contract_contact")
  isTaxContact         Boolean      @default(false) @map("is_tax_contact")
  isOperationalContact Boolean      @default(false) @map("is_operational_contact")
  receivesInvoices     Boolean      @default(false) @map("receives_invoices")
  receivesBilling      Boolean      @default(false) @map("receives_billing")
  receivesTaxDocuments Boolean      @default(false) @map("receives_tax_documents")
  receivesContracts    Boolean      @default(false) @map("receives_contracts")
  receivesReports      Boolean      @default(false) @map("receives_reports")
  status               RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  customer  Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contracts CustomerContract[]
  promises  PaymentPromise[]

  @@index([customerId])
  @@map("customer_contacts")
}

/// CNAE (principal ou secundário) do cliente.
model CustomerCnae {
  id          String  @id @default(uuid()) @db.Uuid
  customerId  String  @map("customer_id") @db.Uuid
  cnaeCode    String  @map("cnae_code")
  description String?
  isMain      Boolean @default(false) @map("is_main")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, cnaeCode])
  @@index([customerId])
  @@map("customer_cnaes")
}

/// Identificador bancário aprendido/cadastrado para reconhecimento futuro do cliente em
/// recebimentos (OFX/extratos) — mesma estrutura do módulo de Fornecedores (seção 36-38
/// do prompt de clientes). Nesta etapa apenas a estrutura de dados é criada.
model CustomerBankIdentifier {
  id         String  @id @default(uuid()) @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  companyId  String? @map("company_id") @db.Uuid

  identifierType  String
  identifierValue String       @map("identifier_value")
  normalizedValue String       @map("normalized_value")
  source          String?
  priority        Int          @default(100)
  confidence      Decimal?     @db.Decimal(5, 2)
  confirmedCount  Int          @default(0) @map("confirmed_count")
  rejectedCount   Int          @default(0) @map("rejected_count")
  lastConfirmedAt DateTime?    @map("last_confirmed_at")
  status          RecordStatus @default(ACTIVE)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([normalizedValue])
  @@map("customer_bank_identifiers")
}

/// Vínculo de um cliente global com uma empresa — cada empresa possui sua própria
/// classificação comercial, condições de recebimento, crédito, regras de cobrança,
/// contratos e recorrências (seção 3.2 do prompt de clientes). Prospects (sem contrato
/// ainda) e clientes ativos usam o mesmo registro, distinguidos por `status`.
model CustomerCompanyLink {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  companyId  String @map("company_id") @db.Uuid

  internalCode              String?         @map("internal_code")
  relationshipType          String?         @map("relationship_type")
  customerTypes             CustomerType[]  @map("customer_types")
  source                    CustomerOrigin? @map("source")
  segment                   String?
  commercialResponsibleId   String?         @map("commercial_responsible_id") @db.Uuid
  relationshipResponsibleId String?         @map("relationship_responsible_id") @db.Uuid

  defaultRevenueCategoryId  String?                @map("default_revenue_category_id") @db.Uuid
  defaultSubcategoryId      String?                @map("default_subcategory_id") @db.Uuid
  defaultResultCenterId     String?                @map("default_result_center_id") @db.Uuid
  defaultAccountingAccount  String?                @map("default_accounting_account")
  defaultProductService     String?                @map("default_product_service")
  defaultDescription        String?                @map("default_description")
  defaultHistory            String?                @map("default_history")
  abcClassification         AbcClassification      @default(NOT_CLASSIFIED) @map("abc_classification")
  revenuePotentialLevel     RevenuePotentialLevel? @map("revenue_potential_level")
  estimatedMonthlyRevenue   Decimal?               @map("estimated_monthly_revenue") @db.Decimal(18, 2)
  estimatedAnnualRevenue    Decimal?               @map("estimated_annual_revenue") @db.Decimal(18, 2)
  estimatedAverageTicket    Decimal?               @map("estimated_average_ticket") @db.Decimal(18, 2)
  estimatedMarginPercentage Decimal?               @map("estimated_margin_percentage") @db.Decimal(5, 2)

  paymentTermDays                  Int?                   @map("payment_term_days")
  defaultDueDay                    Int?                   @map("default_due_day")
  billingFrequency                 RecurrencePeriodicity? @map("billing_frequency")
  preferredPaymentMethod           CustomerPaymentMethod? @map("preferred_payment_method")
  preferredCompanyBankAccountId    String?                @map("preferred_company_bank_account_id") @db.Uuid
  preferredCompanyPixKeyId         String?                @map("preferred_company_pix_key_id") @db.Uuid
  defaultLateFeePercentage         Decimal?               @map("default_late_fee_percentage") @db.Decimal(5, 2)
  defaultMonthlyInterestPercentage Decimal?               @map("default_monthly_interest_percentage") @db.Decimal(5, 2)
  defaultDiscountPercentage        Decimal?               @map("default_discount_percentage") @db.Decimal(5, 2)
  earlyPaymentDiscountPercentage   Decimal?               @map("early_payment_discount_percentage") @db.Decimal(5, 2)
  earlyPaymentDays                 Int?                   @map("early_payment_days")
  gracePeriodDays                  Int?                   @default(0) @map("grace_period_days")

  creditLimit               Decimal?          @map("credit_limit") @db.Decimal(18, 2)
  riskLevel                 CustomerRiskLevel @default(NOT_ASSESSED) @map("risk_level")
  allowOverCreditLimit      Boolean           @default(false) @map("allow_over_credit_limit")
  requiresOverLimitApproval Boolean           @default(true) @map("requires_over_limit_approval")
  maximumPaymentTermDays    Int?              @map("maximum_payment_term_days")
  automaticBlockEnabled     Boolean           @default(false) @map("automatic_block_enabled")
  automaticBlockDays        Int?              @map("automatic_block_days")
  billingRulesEnabled       Boolean           @default(false) @map("billing_rules_enabled")

  autoIdentificationEnabled        Boolean @default(true) @map("auto_identification_enabled")
  autoRevenueClassificationEnabled Boolean @default(true) @map("auto_revenue_classification_enabled")
  autoResultCenterEnabled          Boolean @default(true) @map("auto_result_center_enabled")
  receivableSuggestionEnabled      Boolean @default(true) @map("receivable_suggestion_enabled")
  autoReceivableCreationEnabled    Boolean @default(false) @map("auto_receivable_creation_enabled")
  autoReceiptMatchingEnabled       Boolean @default(false) @map("auto_receipt_matching_enabled")
  confirmationThreshold            Decimal @default(95) @map("confirmation_threshold") @db.Decimal(5, 2)

  status           CustomerLinkStatus      @default(PROSPECT)
  financialStatus  CustomerFinancialStatus @default(NO_ACTIVITY) @map("financial_status")
  blockReason      String?                 @map("block_reason")
  suspensionReason String?                 @map("suspension_reason")
  internalNotes    String?                 @map("internal_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  customer               Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultRevenueCategory FinancialCategory? @relation("CustomerLinkDefaultRevenueCategory", fields: [defaultRevenueCategoryId], references: [id])
  defaultSubcategory     FinancialCategory? @relation("CustomerLinkDefaultSubcategory", fields: [defaultSubcategoryId], references: [id])
  defaultResultCenter    CostCenter?        @relation(fields: [defaultResultCenterId], references: [id])

  billingRules         CustomerBillingRule[]
  collectionHistory    CustomerCollectionHistory[]
  paymentPromises      PaymentPromise[]
  contracts            CustomerContract[]
  recurringReceivables CustomerRecurringReceivable[]
  statusHistory        CustomerStatusHistory[]

  @@unique([customerId, companyId])
  @@index([companyId])
  @@index([customerId])
  @@map("customer_company_links")
}

/// Regra de cobrança configurável do vínculo (seção 47-49 do prompt de clientes). Nesta
/// etapa apenas cria a configuração e o histórico — nenhum envio real é disparado.
model CustomerBillingRule {
  id                    String @id @default(uuid()) @db.Uuid
  customerCompanyLinkId String @map("customer_company_link_id") @db.Uuid

  ruleType          String?
  referenceEvent    String            @map("reference_event")
  daysOffset        Int               @map("days_offset")
  channel           CollectionChannel
  messageTemplateId String?           @map("message_template_id") @db.Uuid
  preferredHour     Int?              @map("preferred_hour")
  allowedWeekdays   Int[]             @map("allowed_weekdays")
  automatic         Boolean           @default(false)
  requiresApproval  Boolean           @default(true) @map("requires_approval")
  responsibleUserId String?           @map("responsible_user_id") @db.Uuid
  priority          Int               @default(100)
  status            RecordStatus      @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  link CustomerCompanyLink @relation(fields: [customerCompanyLinkId], references: [id], onDelete: Cascade)

  @@index([customerCompanyLinkId])
  @@map("customer_billing_rules")
}

/// Histórico de cobranças registradas (seção 50) — o envio real (e-mail/WhatsApp/SMS)
/// depende de integração futura; aqui apenas o registro é criado.
model CustomerCollectionHistory {
  id                    String  @id @default(uuid()) @db.Uuid
  organizationId        String? @map("organization_id") @db.Uuid
  companyId             String? @map("company_id") @db.Uuid
  customerCompanyLinkId String  @map("customer_company_link_id") @db.Uuid
  financialEntryId      String? @map("financial_entry_id") @db.Uuid
  contractId            String? @map("contract_id") @db.Uuid

  channel           CollectionChannel
  recipientName     String?           @map("recipient_name")
  recipientAddress  String?           @map("recipient_address")
  subject           String?
  message           String?
  sentAt            DateTime?         @map("sent_at")
  deliveryStatus    String?           @map("delivery_status")
  response          String?
  responsibleUserId String?           @map("responsible_user_id") @db.Uuid
  notes             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  link     CustomerCompanyLink @relation(fields: [customerCompanyLinkId], references: [id], onDelete: Cascade)
  contract CustomerContract?   @relation(fields: [contractId], references: [id])
  promises PaymentPromise[]

  @@index([customerCompanyLinkId])
  @@map("customer_collection_history")
}

/// Promessa de pagamento (seção 51-52) — atualização de status é manual nesta etapa.
model PaymentPromise {
  id                    String  @id @default(uuid()) @db.Uuid
  organizationId        String? @map("organization_id") @db.Uuid
  companyId             String? @map("company_id") @db.Uuid
  customerCompanyLinkId String  @map("customer_company_link_id") @db.Uuid
  financialEntryId      String? @map("financial_entry_id") @db.Uuid
  collectionHistoryId   String? @map("collection_history_id") @db.Uuid

  promisedAmount    Decimal              @map("promised_amount") @db.Decimal(18, 2)
  promisedDate      DateTime             @map("promised_date")
  fulfilledAmount   Decimal?             @map("fulfilled_amount") @db.Decimal(18, 2)
  fulfilledAt       DateTime?            @map("fulfilled_at")
  status            PaymentPromiseStatus @default(OPEN)
  customerContactId String?              @map("customer_contact_id") @db.Uuid
  responsibleUserId String?              @map("responsible_user_id") @db.Uuid
  notes             String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  link              CustomerCompanyLink        @relation(fields: [customerCompanyLinkId], references: [id], onDelete: Cascade)
  collectionHistory CustomerCollectionHistory? @relation(fields: [collectionHistoryId], references: [id])
  customerContact   CustomerContact?           @relation(fields: [customerContactId], references: [id])

  @@index([customerCompanyLinkId])
  @@map("payment_promises")
}

/// Contrato do cliente com a empresa (seção 53-58 do prompt de clientes).
model CustomerContract {
  id                    String @id @default(uuid()) @db.Uuid
  customerCompanyLinkId String @map("customer_company_link_id") @db.Uuid

  contractNumber         String?
  description            String?
  object                 String?
  productService         String?                @map("product_service")
  planName               String?                @map("plan_name")
  initialValue           Decimal?               @map("initial_value") @db.Decimal(18, 2)
  currentValue           Decimal?               @map("current_value") @db.Decimal(18, 2)
  signatureDate          DateTime?              @map("signature_date")
  startDate              DateTime?              @map("start_date")
  endDate                DateTime?              @map("end_date")
  isIndefiniteTerm       Boolean                @default(false) @map("is_indefinite_term")
  automaticRenewal       Boolean                @default(false) @map("automatic_renewal")
  renewalNoticeDays      Int?                   @map("renewal_notice_days")
  billingFrequency       RecurrencePeriodicity? @map("billing_frequency")
  dueDay                 Int?                   @map("due_day")
  adjustmentType         AdjustmentType?        @map("adjustment_type")
  adjustmentIndex        String?                @map("adjustment_index")
  adjustmentPercentage   Decimal?               @map("adjustment_percentage") @db.Decimal(5, 2)
  adjustmentBaseDate     DateTime?              @map("adjustment_base_date")
  nextAdjustmentDate     DateTime?              @map("next_adjustment_date")
  preferredPaymentMethod CustomerPaymentMethod? @map("preferred_payment_method")
  companyBankAccountId   String?                @map("company_bank_account_id") @db.Uuid
  revenueCategoryId      String?                @map("revenue_category_id") @db.Uuid
  resultCenterId         String?                @map("result_center_id") @db.Uuid
  internalResponsibleId  String?                @map("internal_responsible_id") @db.Uuid
  customerContactId      String?                @map("customer_contact_id") @db.Uuid
  status                 CustomerContractStatus @default(DRAFT)
  notes                  String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  link                 CustomerCompanyLink           @relation(fields: [customerCompanyLinkId], references: [id], onDelete: Cascade)
  revenueCategory      FinancialCategory?            @relation("ContractRevenueCategory", fields: [revenueCategoryId], references: [id])
  resultCenter         CostCenter?                   @relation(fields: [resultCenterId], references: [id])
  customerContact      CustomerContact?              @relation(fields: [customerContactId], references: [id])
  amendments           CustomerContractAmendment[]
  collectionHistory    CustomerCollectionHistory[]
  recurringReceivables CustomerRecurringReceivable[]

  @@index([customerCompanyLinkId])
  @@map("customer_contracts")
}

/// Aditivo contratual (seção 58).
model CustomerContractAmendment {
  id         String @id @default(uuid()) @db.Uuid
  contractId String @map("contract_id") @db.Uuid

  amendmentNumber      String?      @map("amendment_number")
  description          String?
  effectiveDate        DateTime?    @map("effective_date")
  previousValue        Decimal?     @map("previous_value") @db.Decimal(18, 2)
  newValue             Decimal?     @map("new_value") @db.Decimal(18, 2)
  previousEndDate      DateTime?    @map("previous_end_date")
  newEndDate           DateTime?    @map("new_end_date")
  scopeChanged         Boolean      @default(false) @map("scope_changed")
  documentAttachmentId String?      @map("document_attachment_id") @db.Uuid
  status               RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  contract CustomerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("customer_contract_amendments")
}

/// Recorrência financeira vinculada ao contrato (seção 56). Enquanto o módulo de contas a
/// receber não existir, `processingStatus` permanece `PENDING_FINANCIAL_MODULE` — nenhum
/// lançamento financeiro definitivo é gerado nesta etapa.
model CustomerRecurringReceivable {
  id                    String  @id @default(uuid()) @db.Uuid
  customerCompanyLinkId String  @map("customer_company_link_id") @db.Uuid
  contractId            String? @map("contract_id") @db.Uuid

  description                    String?
  amount                         Decimal                    @db.Decimal(18, 2)
  frequency                      RecurrencePeriodicity
  firstDueDate                   DateTime?                  @map("first_due_date")
  fixedDueDay                    Int?                       @map("fixed_due_day")
  startDate                      DateTime?                  @map("start_date")
  endDate                        DateTime?                  @map("end_date")
  installmentCount               Int?                       @map("installment_count")
  revenueCategoryId              String?                    @map("revenue_category_id") @db.Uuid
  subcategoryId                  String?                    @map("subcategory_id") @db.Uuid
  resultCenterId                 String?                    @map("result_center_id") @db.Uuid
  companyBankAccountId           String?                    @map("company_bank_account_id") @db.Uuid
  paymentMethod                  CustomerPaymentMethod?     @map("payment_method")
  lateFeePercentage              Decimal?                   @map("late_fee_percentage") @db.Decimal(5, 2)
  monthlyInterestPercentage      Decimal?                   @map("monthly_interest_percentage") @db.Decimal(5, 2)
  discountPercentage             Decimal?                   @map("discount_percentage") @db.Decimal(5, 2)
  earlyPaymentDiscountPercentage Decimal?                   @map("early_payment_discount_percentage") @db.Decimal(5, 2)
  generationAdvanceDays          Int?                       @map("generation_advance_days")
  automaticGenerationEnabled     Boolean                    @default(false) @map("automatic_generation_enabled")
  processingStatus               RecurrenceProcessingStatus @default(PENDING_FINANCIAL_MODULE) @map("processing_status")
  status                         RecordStatus               @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  link     CustomerCompanyLink @relation(fields: [customerCompanyLinkId], references: [id], onDelete: Cascade)
  contract CustomerContract?   @relation(fields: [contractId], references: [id])

  @@index([customerCompanyLinkId])
  @@map("customer_recurring_receivables")
}

/// Histórico de consultas cadastrais (CPF/CNPJ) de clientes via provider externo
/// desacoplado — reaproveita o mesmo provider do Cadastro de Empresas/Fornecedores.
model CustomerRegistryQuery {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  customerId     String? @map("customer_id") @db.Uuid

  documentNumber  String              @map("document_number")
  provider        String
  requestStatus   RegistryQueryStatus @map("request_status")
  responseSummary Json?               @map("response_summary")
  queriedBy       String?             @map("queried_by") @db.Uuid
  queriedAt       DateTime            @default(now()) @map("queried_at")
  errorCode       String?             @map("error_code")
  errorMessage    String?             @map("error_message")

  organization Organization? @relation(fields: [organizationId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])

  @@index([documentNumber])
  @@index([customerId])
  @@map("customer_registry_queries")
}

/// Histórico de mudanças de status — cadastro geral e/ou vínculo (status cadastral e
/// status financeiro, seção 41 e 87 do prompt de clientes).
model CustomerStatusHistory {
  id                      String   @id @default(uuid()) @db.Uuid
  customerId              String?  @map("customer_id") @db.Uuid
  customerCompanyLinkId   String?  @map("customer_company_link_id") @db.Uuid
  previousStatus          String?  @map("previous_status")
  newStatus               String   @map("new_status")
  previousFinancialStatus String?  @map("previous_financial_status")
  newFinancialStatus      String?  @map("new_financial_status")
  reason                  String?
  changedBy               String?  @map("changed_by") @db.Uuid
  changedAt               DateTime @default(now()) @map("changed_at")

  customer Customer?            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  link     CustomerCompanyLink? @relation(fields: [customerCompanyLinkId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerCompanyLinkId])
  @@map("customer_status_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// Estrutura Financeira — models
// ─────────────────────────────────────────────────────────────────────────────

/// Plano de contas em árvore de profundidade ilimitada (1 → 1.1 → 1.1.01 → ...).
/// Contas sintéticas agrupam; apenas contas analíticas aceitam lançamentos.
model FinancialAccountPlan {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  /// Nulo = conta compartilhada por toda a organização; preenchido = conta exclusiva da empresa.
  companyId       String? @map("company_id") @db.Uuid
  parentAccountId String? @map("parent_account_id") @db.Uuid

  code        String  @db.VarChar(50)
  name        String
  description String?

  accountType    AccountPlanType @default(EXPENSE) @map("account_type")
  /// Código sem separadores/zeros à esquerda — garante unicidade real e busca estável.
  normalizedCode String?         @map("normalized_code") @db.VarChar(50)
  shortName      String?         @map("short_name") @db.VarChar(60)

  /// Finalidade do plano: gerencial, financeiro, contábil ou híbrido (seção 10).
  planType AccountPlanKind @default(MANAGEMENT) @map("plan_type")

  /// Versão do plano à qual a conta pertence (seção 14).
  versionId String? @map("version_id") @db.Uuid

  /// Grupo livre de apresentação/agrupamento em relatórios.
  accountGroup String? @map("account_group") @db.VarChar(80)

  allowsAllocations Boolean @default(true) @map("allows_allocations")
  allowsBudget      Boolean @default(true) @map("allows_budget")

  showInCashFlow          Boolean @default(true) @map("show_in_cash_flow")
  showInIncomeStatement   Boolean @default(true) @map("show_in_income_statement")
  showInManagementBalance Boolean @default(false) @map("show_in_management_balance")
  showInReports           Boolean @default(true) @map("show_in_reports")

  /// Momento do último uso em lançamentos — alimentado pelo módulo financeiro futuro.
  lastUsedAt DateTime? @map("last_used_at")

  structureStatus StructureStatus @default(ACTIVE) @map("structure_status")
  accountKind     AccountKind     @default(ANALYTICAL) @map("account_kind")

  financialNatureId String? @map("financial_nature_id") @db.Uuid

  /// Contas sintéticas devem manter `false`; validado no serviço.
  acceptsEntries Boolean @default(true) @map("accepts_entries")

  color     String? @db.VarChar(20)
  icon      String? @db.VarChar(50)
  sortOrder Int     @default(0) @map("sort_order")
  level     Int     @default(0)
  path      String?
  notes     String?
  isSystem  Boolean @default(false) @map("is_system")

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentAccount   FinancialAccountPlan?        @relation("AccountPlanHierarchy", fields: [parentAccountId], references: [id])
  version         FinancialAccountPlanVersion? @relation(fields: [versionId], references: [id])
  children        FinancialAccountPlan[]       @relation("AccountPlanHierarchy")
  financialNature FinancialNatureCatalog?      @relation("AccountPlanFinancialNature", fields: [financialNatureId], references: [id])

  categories          FinancialCategory[]        @relation("CategoryAccountPlan")
  classificationRules ClassificationRule[]
  allocationLines     AllocationRuleItem[]       @relation("AllocationLineAccountPlan")
  tagLinks            FinancialTagLink[]         @relation("AccountPlanTagLinks")
  ruleActions         ClassificationRuleAction[] @relation("RuleActionAccountPlan")
  financialAccounts   FinancialAccount[]         @relation("FinancialAccountPlanLink")
  corporateCards      CorporateCard[]            @relation("CardAccountPlan")

  @@unique([organizationId, companyId, code])
  @@index([organizationId])
  @@index([companyId])
  @@index([parentAccountId])
  @@map("financial_account_plans")
}

/// Centro de resultado — estrutura própria, completamente separada do centro de custo
/// (seção "Centro de Resultado" do prompt). Também em árvore.
model ResultCenter {
  id                   String  @id @default(uuid()) @db.Uuid
  companyId            String  @map("company_id") @db.Uuid
  parentResultCenterId String? @map("parent_result_center_id") @db.Uuid

  code        String? @db.VarChar(50)
  name        String
  description String?
  color       String? @db.VarChar(20)
  icon        String? @db.VarChar(50)
  sortOrder   Int     @default(0) @map("sort_order")
  level       Int     @default(0)
  path        String?
  notes       String?

  acceptsEntries    Boolean @default(true) @map("accepts_entries")
  isSystem          Boolean @default(false) @map("is_system")
  responsibleUserId String? @map("responsible_user_id") @db.Uuid

  normalizedCode         String?   @map("normalized_code") @db.VarChar(50)
  organizationId         String?   @map("organization_id") @db.Uuid
  businessUnitId         String?   @map("business_unit_id") @db.Uuid
  primaryCustomerId      String?   @map("primary_customer_id") @db.Uuid
  /// Produto/serviço principal em texto livre — não há catálogo de produtos nesta etapa.
  primaryProductService  String?   @map("primary_product_service")
  revenueTarget          Decimal?  @map("revenue_target") @db.Decimal(18, 2)
  marginTargetPercentage Decimal?  @map("margin_target_percentage") @db.Decimal(7, 4)
  budgetAmount           Decimal?  @map("budget_amount") @db.Decimal(18, 2)
  startDate              DateTime? @map("start_date") @db.Date
  endDate                DateTime? @map("end_date") @db.Date

  lastUsedAt      DateTime?       @map("last_used_at")
  structureStatus StructureStatus @default(ACTIVE) @map("structure_status")

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentResultCenter ResultCenter?  @relation("ResultCenterHierarchy", fields: [parentResultCenterId], references: [id])
  businessUnit       BusinessUnit?  @relation("ResultCenterBusinessUnit", fields: [businessUnitId], references: [id])
  primaryCustomer    Customer?      @relation("ResultCenterPrimaryCustomer", fields: [primaryCustomerId], references: [id])
  children           ResultCenter[] @relation("ResultCenterHierarchy")

  defaultForCategories FinancialCategory[]        @relation("CategoryDefaultResultCenter")
  projects             Project[]                  @relation("ProjectResultCenter")
  classificationRules  ClassificationRule[]
  allocationLines      AllocationRuleItem[]       @relation("AllocationLineResultCenter")
  tagLinks             FinancialTagLink[]         @relation("ResultCenterTagLinks")
  ruleActions          ClassificationRuleAction[] @relation("RuleActionResultCenter")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, parentResultCenterId])
  @@map("result_centers")
}

/// Projeto — dimensão adicional de análise. `realizedAmount`/`margin` permanecem nulos
/// até o módulo financeiro existir; nada é calculado nesta etapa.
model Project {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  code        String? @db.VarChar(50)
  name        String
  description String?

  /// Cliente do projeto — reaproveita o Cadastro de Clientes já entregue.
  customerId     String? @map("customer_id") @db.Uuid
  costCenterId   String? @map("cost_center_id") @db.Uuid
  resultCenterId String? @map("result_center_id") @db.Uuid
  businessUnitId String? @map("business_unit_id") @db.Uuid

  responsibleUserId String? @map("responsible_user_id") @db.Uuid

  startDate DateTime? @map("start_date") @db.Date
  /// Data **prevista** de término (o `actual_end_date` guarda a real).
  endDate   DateTime? @map("end_date") @db.Date

  status   ProjectStatus   @default(PLANNING)
  priority ProjectPriority @default(MEDIUM)

  normalizedCode    String?   @map("normalized_code") @db.VarChar(50)
  organizationId    String?   @map("organization_id") @db.Uuid
  parentProjectId   String?   @map("parent_project_id") @db.Uuid
  primarySupplierId String?   @map("primary_supplier_id") @db.Uuid
  actualEndDate     DateTime? @map("actual_end_date") @db.Date

  /// Orçamentos separados por espécie (seção 27.2).
  revenueBudget Decimal? @map("revenue_budget") @db.Decimal(18, 2)
  costBudget    Decimal? @map("cost_budget") @db.Decimal(18, 2)
  expenseBudget Decimal? @map("expense_budget") @db.Decimal(18, 2)

  plannedMarginPercentage Decimal? @map("planned_margin_percentage") @db.Decimal(7, 4)
  /// Percentual de conclusão informado manualmente nesta etapa.
  completionPercentage    Decimal? @map("completion_percentage") @db.Decimal(5, 2)

  /// Preenchidos pelo módulo financeiro futuro — sempre nulos nesta etapa.
  realizedRevenue Decimal? @map("realized_revenue") @db.Decimal(18, 2)
  realizedCost    Decimal? @map("realized_cost") @db.Decimal(18, 2)
  realizedExpense Decimal? @map("realized_expense") @db.Decimal(18, 2)

  lastUsedAt      DateTime?       @map("last_used_at")
  structureStatus StructureStatus @default(ACTIVE) @map("structure_status")

  budgetAmount     Decimal? @map("budget_amount") @db.Decimal(18, 2)
  /// Preenchido pelo módulo financeiro futuro — sempre nulo nesta etapa.
  realizedAmount   Decimal? @map("realized_amount") @db.Decimal(18, 2)
  marginPercentage Decimal? @map("margin_percentage") @db.Decimal(7, 4)

  color String? @db.VarChar(20)
  icon  String? @db.VarChar(50)
  notes String?

  recordStatus RecordStatus @default(ACTIVE) @map("record_status")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentProject   Project?      @relation("ProjectHierarchy", fields: [parentProjectId], references: [id])
  childProjects   Project[]     @relation("ProjectHierarchy")
  primarySupplier Supplier?     @relation("ProjectPrimarySupplier", fields: [primarySupplierId], references: [id])
  customer        Customer?     @relation("ProjectCustomer", fields: [customerId], references: [id])
  costCenter      CostCenter?   @relation("ProjectCostCenter", fields: [costCenterId], references: [id])
  resultCenter    ResultCenter? @relation("ProjectResultCenter", fields: [resultCenterId], references: [id])
  businessUnit    BusinessUnit? @relation("ProjectBusinessUnit", fields: [businessUnitId], references: [id])

  ruleActions          ClassificationRuleAction[] @relation("RuleActionProject")
  defaultForCategories FinancialCategory[]        @relation("CategoryDefaultProject")
  classificationRules  ClassificationRule[]
  allocationLines      AllocationRuleItem[]       @relation("AllocationLineProject")
  tagLinks             FinancialTagLink[]         @relation("ProjectTagLinks")
  cardsAsDefault       CorporateCard[]            @relation("CardDefaultProject")
  cardUsers            CorporateCardUser[]        @relation("CardUserProject")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@map("projects")
}

/// Unidade de negócio — dimensão independente (ex.: BPO Financeiro, Tecnologia, Holding).
/// Pode ser compartilhada pela organização (`companyId` nulo) ou exclusiva de uma empresa.
model BusinessUnit {
  id                   String  @id @default(uuid()) @db.Uuid
  organizationId       String  @map("organization_id") @db.Uuid
  companyId            String? @map("company_id") @db.Uuid
  parentBusinessUnitId String? @map("parent_business_unit_id") @db.Uuid

  code        String? @db.VarChar(50)
  name        String
  description String?
  color       String? @db.VarChar(20)
  icon        String? @db.VarChar(50)
  sortOrder   Int     @default(0) @map("sort_order")
  level       Int     @default(0)
  path        String?
  notes       String?

  responsibleUserId String? @map("responsible_user_id") @db.Uuid
  isSystem          Boolean @default(false) @map("is_system")

  normalizedCode String?          @map("normalized_code") @db.VarChar(50)
  unitType       BusinessUnitType @default(OPERATIONAL_UNIT) @map("unit_type")
  /// Endereço da unidade — referência lógica para `company_addresses`.
  addressId      String?          @map("address_id") @db.Uuid
  startDate      DateTime?        @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  revenueTarget  Decimal?         @map("revenue_target") @db.Decimal(18, 2)
  budgetAmount   Decimal?         @map("budget_amount") @db.Decimal(18, 2)

  lastUsedAt      DateTime?       @map("last_used_at")
  structureStatus StructureStatus @default(ACTIVE) @map("structure_status")

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company            Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentBusinessUnit BusinessUnit?  @relation("BusinessUnitHierarchy", fields: [parentBusinessUnitId], references: [id])
  children           BusinessUnit[] @relation("BusinessUnitHierarchy")

  costCenters          CostCenter[]               @relation("CostCenterBusinessUnit")
  resultCenters        ResultCenter[]             @relation("ResultCenterBusinessUnit")
  ruleActions          ClassificationRuleAction[] @relation("RuleActionBusinessUnit")
  defaultForCategories FinancialCategory[]        @relation("CategoryDefaultBusinessUnit")
  projects             Project[]                  @relation("ProjectBusinessUnit")
  classificationRules  ClassificationRule[]
  allocationLines      AllocationRuleItem[]       @relation("AllocationLineBusinessUnit")
  tagLinks             FinancialTagLink[]         @relation("BusinessUnitTagLinks")
  financialAccounts    FinancialAccount[]
  corporateCards       CorporateCard[]
  cardUsers            CorporateCardUser[]        @relation("CardUserBusinessUnit")

  @@unique([organizationId, companyId, code])
  @@index([organizationId])
  @@index([companyId])
  @@map("business_units")
}

/// Catálogo de naturezas financeiras. O model chama-se `FinancialNatureCatalog` porque o
/// nome `FinancialNature` já pertence ao enum entregue no módulo de Fornecedores; a tabela
/// segue com o nome exigido pelo prompt (`financial_natures`).
model FinancialNatureCatalog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid

  code        String?             @db.VarChar(50)
  name        String
  description String?
  kind        FinancialNatureKind @default(EXPENSE)

  natureGroup FinancialNatureGroup @default(OTHER) @map("nature_group")

  /// Efeito detalhado sobre caixa, resultado e patrimônio (seções 32-33).
  cashEffect    NatureEffect  @default(NONE) @map("cash_effect")
  resultEffect  NatureEffect  @default(NONE) @map("result_effect")
  equityEffect  NatureEffect  @default(NONE) @map("equity_effect")
  flowDirection FlowDirection @default(NONE) @map("flow_direction")

  showInDashboard       Boolean @default(true) @map("show_in_dashboard")
  showInCashFlow        Boolean @default(true) @map("show_in_cash_flow")
  showInIncomeStatement Boolean @default(true) @map("show_in_income_statement")

  structureStatus StructureStatus @default(ACTIVE) @map("structure_status")

  /// Se o valor impacta o resultado (DRE) — transferências/aportes normalmente não impactam.
  affectsResult   Boolean @default(true) @map("affects_result")
  /// Se o valor impacta o caixa (DFC).
  affectsCashFlow Boolean @default(true) @map("affects_cash_flow")

  color     String? @db.VarChar(20)
  icon      String? @db.VarChar(50)
  sortOrder Int     @default(0) @map("sort_order")
  isSystem  Boolean @default(false) @map("is_system")

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ruleActions         ClassificationRuleAction[] @relation("RuleActionNature")
  categories          FinancialCategory[]        @relation("CategoryFinancialNature")
  accountPlans        FinancialAccountPlan[]     @relation("AccountPlanFinancialNature")
  classificationRules ClassificationRule[]
  financialAccounts   FinancialAccount[]         @relation("FinancialAccountNature")

  @@unique([organizationId, companyId, code])
  @@index([organizationId])
  @@index([companyId])
  @@map("financial_natures")
}

/// Tag financeira livre (modelo Notion): um lançamento ou cadastro pode receber várias.
model FinancialTag {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid

  name            String
  /// Nome normalizado (minúsculo, sem espaços duplicados) — garante unicidade real.
  slug            String
  /// Alias do slug com o nome exigido pela seção 62.
  normalizedName  String?         @map("normalized_name")
  scope           TagScope        @default(ORGANIZATION)
  structureStatus StructureStatus @default(ACTIVE) @map("structure_status")
  description     String?
  color           String?         @db.VarChar(20)
  icon            String?         @db.VarChar(50)
  /// Agrupador opcional das tags (ex.: "Contratos", "Prioridade").
  group           String?         @db.VarChar(80)

  /// Contador denormalizado de usos, mantido pelo serviço ao vincular/desvincular.
  usageCount Int @default(0) @map("usage_count")

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  links       FinancialTagLink[]
  ruleActions ClassificationRuleAction[] @relation("RuleActionTag")

  @@unique([organizationId, companyId, slug])
  @@index([organizationId])
  @@index([companyId])
  @@map("financial_tags")
}

/// Vínculo polimórfico entre uma tag e qualquer cadastro da estrutura financeira.
/// Exatamente uma das colunas de destino deve estar preenchida (validado no serviço).
model FinancialTagLink {
  id             String  @id @default(uuid()) @db.Uuid
  tagId          String  @map("tag_id") @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid

  /// Rótulo da entidade alvo, para consultas genéricas e para o futuro vínculo com lançamentos.
  entityType String @map("entity_type") @db.VarChar(50)
  entityId   String @map("entity_id") @db.Uuid

  categoryId     String? @map("category_id") @db.Uuid
  accountPlanId  String? @map("account_plan_id") @db.Uuid
  costCenterId   String? @map("cost_center_id") @db.Uuid
  resultCenterId String? @map("result_center_id") @db.Uuid
  projectId      String? @map("project_id") @db.Uuid
  businessUnitId String? @map("business_unit_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  tag          FinancialTag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  category     FinancialCategory?    @relation("CategoryTagLinks", fields: [categoryId], references: [id], onDelete: Cascade)
  accountPlan  FinancialAccountPlan? @relation("AccountPlanTagLinks", fields: [accountPlanId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?           @relation("CostCenterTagLinks", fields: [costCenterId], references: [id], onDelete: Cascade)
  resultCenter ResultCenter?         @relation("ResultCenterTagLinks", fields: [resultCenterId], references: [id], onDelete: Cascade)
  project      Project?              @relation("ProjectTagLinks", fields: [projectId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit?         @relation("BusinessUnitTagLinks", fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([tagId])
  @@map("financial_tag_links")
}

/// Regra de classificação automática. Nesta etapa apenas **armazena e simula** — nenhum
/// lançamento é classificado automaticamente, pois os módulos de importação/OFX e de
/// contas a pagar/receber ainda não existem.
model ClassificationRule {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  name        String
  description String?

  matchField    ClassificationMatchField @default(DESCRIPTION) @map("match_field")
  matchType     ClassificationMatchType  @default(CONTAINS) @map("match_type")
  matchValue    String                   @map("match_value")
  /// Comparação sem diferenciar maiúsculas/minúsculas e acentos.
  caseSensitive Boolean                  @default(false) @map("case_sensitive")

  minAmount Decimal? @map("min_amount") @db.Decimal(18, 2)
  maxAmount Decimal? @map("max_amount") @db.Decimal(18, 2)

  origin TransactionOrigin @default(ANY)

  // ── Dimensões aplicadas quando a regra casa ──
  categoryId        String? @map("category_id") @db.Uuid
  subcategoryId     String? @map("subcategory_id") @db.Uuid
  accountPlanId     String? @map("account_plan_id") @db.Uuid
  costCenterId      String? @map("cost_center_id") @db.Uuid
  resultCenterId    String? @map("result_center_id") @db.Uuid
  projectId         String? @map("project_id") @db.Uuid
  businessUnitId    String? @map("business_unit_id") @db.Uuid
  financialNatureId String? @map("financial_nature_id") @db.Uuid
  allocationRuleId  String? @map("allocation_rule_id") @db.Uuid
  supplierId        String? @map("supplier_id") @db.Uuid
  customerId        String? @map("customer_id") @db.Uuid

  appliedDescription String? @map("applied_description")
  appliedHistory     String? @map("applied_history")

  /// Menor valor = maior prioridade na resolução de conflitos entre regras.
  priority            Int     @default(100)
  /// Confiança mínima (0-100) para aplicar sem confirmação humana — usado pelo motor futuro.
  confidenceThreshold Int     @default(95) @map("confidence_threshold")
  /// Se `false`, a regra apenas sugere e exige confirmação.
  autoApply           Boolean @default(false) @map("auto_apply")

  source ClassificationRuleSource @default(MANUAL)

  /// Estatísticas de aprendizado, alimentadas pelo motor futuro.
  matchCount     Int       @default(0) @map("match_count")
  confirmedCount Int       @default(0) @map("confirmed_count")
  rejectedCount  Int       @default(0) @map("rejected_count")
  lastMatchedAt  DateTime? @map("last_matched_at")

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  company              Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category             FinancialCategory?            @relation(fields: [categoryId], references: [id])
  accountPlan          FinancialAccountPlan?         @relation(fields: [accountPlanId], references: [id])
  costCenter           CostCenter?                   @relation(fields: [costCenterId], references: [id])
  resultCenter         ResultCenter?                 @relation(fields: [resultCenterId], references: [id])
  project              Project?                      @relation(fields: [projectId], references: [id])
  businessUnit         BusinessUnit?                 @relation(fields: [businessUnitId], references: [id])
  financialNature      FinancialNatureCatalog?       @relation(fields: [financialNatureId], references: [id])
  allocationRule       AllocationRule?               @relation("ClassificationRuleAllocation", fields: [allocationRuleId], references: [id])
  conditions           ClassificationRuleCondition[]
  actions              ClassificationRuleAction[]
  sourceType           TransactionOrigin             @default(ANY) @map("source_type")
  automatic            Boolean                       @default(false)
  requiresConfirmation Boolean                       @default(true) @map("requires_confirmation")
  startDate            DateTime?                     @map("start_date") @db.Date
  endDate              DateTime?                     @map("end_date") @db.Date
  usageCount           Int                           @default(0) @map("usage_count")
  structureStatus      StructureStatus               @default(ACTIVE) @map("structure_status")

  @@index([companyId])
  @@index([companyId, priority])
  @@index([categoryId])
  @@map("classification_rules")
}

/// Cabeçalho de um rateio padrão reutilizável (ex.: "Energia 60/40").
model AllocationRule {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  name        String
  description String?
  criterion   AllocationCriterion @default(PERCENTAGE)

  /// Categoria à qual este rateio pertence por padrão (opcional).
  categoryId String? @map("category_id") @db.Uuid

  /// Descrição do critério quando `criterion = CUSTOM`.
  customCriterionLabel String? @map("custom_criterion_label")

  isDefault Boolean      @default(false) @map("is_default")
  status    RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category FinancialCategory? @relation("AllocationRuleCategory", fields: [categoryId], references: [id])

  items                AllocationRuleItem[]
  defaultForCategories FinancialCategory[]        @relation("CategoryDefaultAllocationRule")
  classificationRules  ClassificationRule[]       @relation("ClassificationRuleAllocation")
  ruleActions          ClassificationRuleAction[] @relation("RuleActionAllocation")
  allocationType       AllocationCriterion        @default(PERCENTAGE) @map("allocation_type")
  defaultSupplierId    String?                    @map("default_supplier_id") @db.Uuid
  defaultCustomerId    String?                    @map("default_customer_id") @db.Uuid
  priority             Int                        @default(100)
  startDate            DateTime?                  @map("start_date") @db.Date
  endDate              DateTime?                  @map("end_date") @db.Date
  structureStatus      StructureStatus            @default(ACTIVE) @map("structure_status")

  @@index([companyId])
  @@index([categoryId])
  @@map("allocation_rules")
}

/// Linha de rateio. Para `PERCENTAGE`, a soma das linhas da regra deve fechar 100%
/// (validado em `AllocationRulesService`).
model AllocationRuleItem {
  id               String @id @default(uuid()) @db.Uuid
  allocationRuleId String @map("allocation_rule_id") @db.Uuid

  targetType AllocationTargetType @map("target_type")

  costCenterId   String? @map("cost_center_id") @db.Uuid
  resultCenterId String? @map("result_center_id") @db.Uuid
  projectId      String? @map("project_id") @db.Uuid
  businessUnitId String? @map("business_unit_id") @db.Uuid
  categoryId     String? @map("category_id") @db.Uuid
  accountPlanId  String? @map("account_plan_id") @db.Uuid

  /// Preenchido quando o critério da regra é `PERCENTAGE`.
  percentage  Decimal? @db.Decimal(7, 4)
  /// Preenchido para `FIXED_AMOUNT`.
  fixedAmount Decimal? @map("fixed_amount") @db.Decimal(18, 2)
  /// Peso bruto para `QUANTITY`/`HOURS`/`WEIGHT`/`CUSTOM` — o percentual é derivado da soma.
  weight      Decimal? @db.Decimal(18, 4)

  sortOrder Int     @default(0) @map("sort_order")
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  allocationRule AllocationRule        @relation(fields: [allocationRuleId], references: [id], onDelete: Cascade)
  costCenter     CostCenter?           @relation("AllocationLineCostCenter", fields: [costCenterId], references: [id])
  resultCenter   ResultCenter?         @relation("AllocationLineResultCenter", fields: [resultCenterId], references: [id])
  project        Project?              @relation("AllocationLineProject", fields: [projectId], references: [id])
  businessUnit   BusinessUnit?         @relation("AllocationLineBusinessUnit", fields: [businessUnitId], references: [id])
  category       FinancialCategory?    @relation("AllocationLineCategory", fields: [categoryId], references: [id])
  accountPlan    FinancialAccountPlan? @relation("AllocationLineAccountPlan", fields: [accountPlanId], references: [id])
  quantityFactor Decimal?              @map("quantity_factor") @db.Decimal(18, 4)

  @@index([allocationRuleId])
  @@map("allocation_rule_items")
}

/// Snapshot versionado de uma árvore/estrutura, gravado antes de alterações estruturais
/// (mover, renumerar, importar) para permitir auditoria e restauração.
model FinancialHierarchyVersion {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid

  entity        HierarchyEntity
  versionNumber Int             @map("version_number")
  label         String?
  reason        String?

  /// Estrutura completa serializada no momento do snapshot.
  snapshot Json

  itemCount Int @default(0) @map("item_count")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, companyId, entity, versionNumber])
  @@index([organizationId])
  @@index([companyId, entity])
  @@map("financial_hierarchy_versions")
}

/// Lote de importação da estrutura financeira (Excel/CSV/modelos de ERPs).
/// A importação é sempre validada antes de ser aplicada.
model FinancialStructureImport {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid

  entity   HierarchyEntity
  format   StructureImportFormat @default(CSV)
  status   StructureImportStatus @default(PENDING)
  fileName String?               @map("file_name")

  totalRows   Int @default(0) @map("total_rows")
  validRows   Int @default(0) @map("valid_rows")
  invalidRows Int @default(0) @map("invalid_rows")
  createdRows Int @default(0) @map("created_rows")
  updatedRows Int @default(0) @map("updated_rows")

  /// Erros por linha, no formato [{ line, message }].
  errors  Json?
  /// Pré-visualização normalizada das linhas válidas, usada ao aplicar o lote.
  preview Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  appliedAt DateTime? @map("applied_at")
  createdBy String?   @map("created_by") @db.Uuid

  organization         Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company              Company?                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rows                 FinancialStructureImportRow[]
  storagePath          String?                       @map("storage_path")
  importMode           StructureImportMode           @default(INSERT_ONLY) @map("import_mode")
  mappingConfiguration Json?                         @map("mapping_configuration")
  warningRows          Int                           @default(0) @map("warning_rows")
  startedBy            String?                       @map("started_by") @db.Uuid
  startedAt            DateTime?                     @map("started_at")
  completedAt          DateTime?                     @map("completed_at")

  @@index([organizationId])
  @@index([companyId, entity])
  @@map("financial_structure_imports")
}

// ─────────────────────────────────────────────────────────────────────────────
// Estrutura Financeira — tabelas da especificação completa
// ─────────────────────────────────────────────────────────────────────────────

/// Versão do plano de contas (seções 14 e 55). Apenas uma versão pode estar `ACTIVE`
/// por tipo de plano e empresa — regra garantida no serviço, que desativa a anterior.
model FinancialAccountPlanVersion {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid

  name          String
  description   String?
  versionNumber Int             @map("version_number")
  planType      AccountPlanKind @default(MANAGEMENT) @map("plan_type")

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  status AccountPlanVersionStatus @default(DRAFT)
  reason String?

  previousVersionId String?   @map("previous_version_id") @db.Uuid
  activatedBy       String?   @map("activated_by") @db.Uuid
  activatedAt       DateTime? @map("activated_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization    Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  previousVersion FinancialAccountPlanVersion?  @relation("VersionChain", fields: [previousVersionId], references: [id])
  nextVersions    FinancialAccountPlanVersion[] @relation("VersionChain")

  accounts FinancialAccountPlan[]

  @@unique([organizationId, companyId, planType, versionNumber])
  @@index([organizationId])
  @@index([companyId, status])
  @@map("financial_account_plan_versions")
}

/// Condição de uma regra de classificação (seção 63). Separar condições da regra permite
/// combinar vários critérios (descrição **e** faixa de valor **e** origem) sem inflar a
/// tabela principal, como exigido pela seção 36.
model ClassificationRuleCondition {
  id                   String @id @default(uuid()) @db.Uuid
  classificationRuleId String @map("classification_rule_id") @db.Uuid

  field    RuleConditionField
  operator RuleConditionOperator

  value           String
  /// Valor normalizado (maiúsculas, sem acentos/pontuação) para comparação estável.
  normalizedValue String? @map("normalized_value")
  /// Segundo valor, usado por `BETWEEN` (limite superior) e por listas.
  secondaryValue  String? @map("secondary_value")

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  classificationRule ClassificationRule @relation(fields: [classificationRuleId], references: [id], onDelete: Cascade)

  @@index([classificationRuleId])
  @@map("classification_rule_conditions")
}

/// Ação aplicada quando as condições de uma regra casam (seções 37 e 63).
model ClassificationRuleAction {
  id                   String @id @default(uuid()) @db.Uuid
  classificationRuleId String @map("classification_rule_id") @db.Uuid

  supplierId        String? @map("supplier_id") @db.Uuid
  customerId        String? @map("customer_id") @db.Uuid
  categoryId        String? @map("category_id") @db.Uuid
  subcategoryId     String? @map("subcategory_id") @db.Uuid
  accountPlanId     String? @map("account_plan_id") @db.Uuid
  costCenterId      String? @map("cost_center_id") @db.Uuid
  resultCenterId    String? @map("result_center_id") @db.Uuid
  projectId         String? @map("project_id") @db.Uuid
  businessUnitId    String? @map("business_unit_id") @db.Uuid
  financialNatureId String? @map("financial_nature_id") @db.Uuid
  allocationRuleId  String? @map("allocation_rule_id") @db.Uuid
  /// Forma de pagamento/recebimento e conta bancária — FKs lógicas até o módulo existir.
  paymentMethodId   String? @map("payment_method_id") @db.Uuid
  bankAccountId     String? @map("bank_account_id") @db.Uuid
  /// Tag aplicada automaticamente ao lançamento.
  tagId             String? @map("tag_id") @db.Uuid

  defaultDescription String? @map("default_description")
  defaultHistory     String? @map("default_history")
  responsibleUserId  String? @map("responsible_user_id") @db.Uuid

  requiresApproval      Boolean @default(false) @map("requires_approval")
  suggestReconciliation Boolean @default(false) @map("suggest_reconciliation")
  /// Criação de lançamento e baixa automática ficam desligadas até o módulo financeiro existir.
  createFinancialEntry  Boolean @default(false) @map("create_financial_entry")
  autoMatch             Boolean @default(false) @map("auto_match")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  classificationRule ClassificationRule      @relation(fields: [classificationRuleId], references: [id], onDelete: Cascade)
  category           FinancialCategory?      @relation("RuleActionCategory", fields: [categoryId], references: [id])
  subcategory        FinancialCategory?      @relation("RuleActionSubcategory", fields: [subcategoryId], references: [id])
  accountPlan        FinancialAccountPlan?   @relation("RuleActionAccountPlan", fields: [accountPlanId], references: [id])
  costCenter         CostCenter?             @relation("RuleActionCostCenter", fields: [costCenterId], references: [id])
  resultCenter       ResultCenter?           @relation("RuleActionResultCenter", fields: [resultCenterId], references: [id])
  project            Project?                @relation("RuleActionProject", fields: [projectId], references: [id])
  businessUnit       BusinessUnit?           @relation("RuleActionBusinessUnit", fields: [businessUnitId], references: [id])
  financialNature    FinancialNatureCatalog? @relation("RuleActionNature", fields: [financialNatureId], references: [id])
  allocationRule     AllocationRule?         @relation("RuleActionAllocation", fields: [allocationRuleId], references: [id])
  tag                FinancialTag?           @relation("RuleActionTag", fields: [tagId], references: [id])

  @@index([classificationRuleId])
  @@map("classification_rule_actions")
}

/// Linha individual de um arquivo importado (seção 65). Guardar cada linha permite
/// mostrar erros por linha, baixar o relatório de inconsistências e rastrear qual
/// registro foi criado a partir de qual linha.
model FinancialStructureImportRow {
  id       String @id @default(uuid()) @db.Uuid
  importId String @map("import_id") @db.Uuid

  rowNumber Int @map("row_number")

  /// Linha como veio do arquivo e a versão normalizada usada na aplicação.
  originalData   Json  @map("original_data")
  normalizedData Json? @map("normalized_data")

  validationStatus ImportRowStatus @default(VALID) @map("validation_status")
  validationErrors Json?           @map("validation_errors")

  createdEntityType String? @map("created_entity_type") @db.VarChar(50)
  createdEntityId   String? @map("created_entity_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  import FinancialStructureImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, validationStatus])
  @@map("financial_structure_import_rows")
}

/// Histórico de alterações de hierarquia e código (seção 66). Complementa
/// `financial_hierarchy_versions`: enquanto a versão guarda um snapshot completo, aqui
/// fica o antes/depois de cada movimentação individual.
model FinancialHierarchyHistory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid

  entityType HierarchyEntity @map("entity_type")
  entityId   String          @map("entity_id") @db.Uuid

  previousParentId String? @map("previous_parent_id") @db.Uuid
  newParentId      String? @map("new_parent_id") @db.Uuid
  previousCode     String? @map("previous_code") @db.VarChar(50)
  newCode          String? @map("new_code") @db.VarChar(50)
  previousLevel    Int?    @map("previous_level")
  newLevel         Int?    @map("new_level")

  reason    String?
  changedBy String?  @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("financial_hierarchy_history")
}

// ─── Tesouraria: contas financeiras, cartões e meios de pagamento ─────────────

/// Tipos de conta financeira (seção 7). A estrutura é extensível de propósito:
/// caixas e carteiras convivem com contas bancárias sob o mesmo cadastro.
enum FinancialAccountType {
  CHECKING_ACCOUNT
  SAVINGS_ACCOUNT
  PAYMENT_ACCOUNT
  DIGITAL_ACCOUNT
  INVESTMENT_ACCOUNT
  GUARANTEED_ACCOUNT
  CASH
  PETTY_CASH
  DIGITAL_WALLET
  RECEIVING_ACCOUNT
  TRANSIT_ACCOUNT
  COMPENSATION_ACCOUNT
  OTHER

  @@map("financial_account_type")
}

/// Finalidade principal da conta (seção 11).
enum FinancialAccountPurpose {
  PAYMENTS
  RECEIPTS
  PAYROLL
  TAXES
  INVESTMENTS
  OPERATING_CASH
  CORPORATE_EXPENSES
  TRANSFERS
  GUARANTEES
  INTERNAL_MOVEMENTS
  MULTIPLE

  @@map("financial_account_purpose")
}

/// Ciclo de vida da conta financeira (seção 30). Encerrada é terminal: não volta a
/// ativa por reativação simples.
enum FinancialAccountStatus {
  DRAFT
  PENDING_VALIDATION
  ACTIVE
  BLOCKED
  SUSPENDED
  INACTIVE
  CLOSED

  @@map("financial_account_status")
}

/// Regime de conciliação da conta (seção 16).
enum ReconciliationMode {
  MANUAL
  SEMI_AUTOMATIC
  AUTOMATIC_WITH_CONFIRMATION
  AUTOMATIC_BY_RULE
  NOT_RECONCILABLE

  @@map("reconciliation_mode")
}

/// Natureza do saldo informado na implantação (seção 18).
enum BalanceType {
  CREDIT
  DEBIT
  ZERO

  @@map("balance_type")
}

/// Situação do saldo inicial: aprovado é o que vale para os relatórios.
enum OpeningBalanceStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED

  @@map("opening_balance_status")
}

/// Modalidades de limite bancário (seção 21).
enum BankLimitType {
  OVERDRAFT
  GUARANTEED_ACCOUNT
  WORKING_CAPITAL
  RECEIVABLES_ANTICIPATION
  REVOLVING
  OTHER

  @@map("bank_limit_type")
}

/// Finalidade da chave PIX da empresa (seção 22).
enum PixKeyPurpose {
  GENERAL
  BILLING
  SUPPLIERS
  CUSTOMERS
  PAYROLL
  REFUNDS

  @@map("pix_key_purpose")
}

/// Meios de integração bancária previstos (seção 26). Nenhum é executado nesta etapa.
enum BankIntegrationType {
  OFX_MANUAL
  CNAB
  OPEN_FINANCE
  BANK_API
  SFTP
  WEBHOOK
  ERP
  CSV_FILE
  XLSX_FILE
  MANUAL

  @@map("bank_integration_type")
}

enum BankIntegrationStatus {
  NOT_CONFIGURED
  PENDING
  ACTIVE
  ERROR
  SUSPENDED
  DISCONNECTED

  @@map("bank_integration_status")
}

/// Ambiente da integração: homologação e produção nunca compartilham credencial.
enum IntegrationEnvironment {
  SANDBOX
  PRODUCTION

  @@map("integration_environment")
}

enum CorporateCardType {
  CREDIT
  DEBIT
  PREPAID
  MULTIPLE
  VIRTUAL
  OTHER

  @@map("corporate_card_type")
}

enum CorporateCardStatus {
  DRAFT
  ACTIVE
  BLOCKED
  EXPIRED
  CANCELLED
  INACTIVE

  @@map("corporate_card_status")
}

/// Meios de pagamento (seção 41).
enum PaymentMethodType {
  PIX
  BOLETO
