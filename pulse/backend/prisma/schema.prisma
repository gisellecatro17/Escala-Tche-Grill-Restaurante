  defaultReconciliationMode ReconciliationMode @default(MANUAL) @map("default_reconciliation_mode")
  amountTolerance           Decimal            @default(0) @map("amount_tolerance") @db.Decimal(18, 2)
  dateToleranceDays         Int                @default(0) @map("date_tolerance_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  primaryFinancialAccount FinancialAccount? @relation("TreasuryPrimaryAccount", fields: [primaryFinancialAccountId], references: [id])
  defaultPaymentAccount   FinancialAccount? @relation("TreasuryPaymentAccount", fields: [defaultPaymentAccountId], references: [id])
  defaultReceiptAccount   FinancialAccount? @relation("TreasuryReceiptAccount", fields: [defaultReceiptAccountId], references: [id])
  defaultTaxAccount       FinancialAccount? @relation("TreasuryTaxAccount", fields: [defaultTaxAccountId], references: [id])
  defaultPayrollAccount   FinancialAccount? @relation("TreasuryPayrollAccount", fields: [defaultPayrollAccountId], references: [id])
  defaultCashAccount      FinancialAccount? @relation("TreasuryCashAccount", fields: [defaultCashAccountId], references: [id])

  @@index([organizationId])
  @@map("treasury_settings")
}

/// Histórico de mudanças de status da conta, com motivo e responsável.
model FinancialAccountStatusHistory {
