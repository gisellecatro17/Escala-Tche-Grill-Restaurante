/// Entidades que podem figurar como favorecido em um pagamento (seção 45).
enum BeneficiaryEntityType {
  SUPPLIER
  EMPLOYEE
  PARTNER
  CUSTOMER
  GOVERNMENT
  FINANCIAL_INSTITUTION
  OTHER

  @@map("beneficiary_entity_type")
}

/// Conta financeira: conta bancária, caixa, fundo fixo ou carteira digital.
/// Toda movimentação financeira futura apontará para uma conta deste cadastro.
model FinancialAccount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid

  financialInstitutionId String? @map("financial_institution_id") @db.Uuid
  businessUnitId         String? @map("business_unit_id") @db.Uuid
  costCenterId           String? @map("cost_center_id") @db.Uuid
  accountPlanId          String? @map("account_plan_id") @db.Uuid
  financialNatureId      String? @map("financial_nature_id") @db.Uuid

  internalCode String? @map("internal_code") @db.VarChar(50)
  name         String
  /// Nome usado em seletores, relatórios e telas — ex.: "Banco do Brasil — Conta Operacional".
  displayName  String? @map("display_name")

  accountType FinancialAccountType    @map("account_type")
  purpose     FinancialAccountPurpose @default(MULTIPLE)

  branchNumber                String? @map("branch_number") @db.VarChar(20)
  branchDigit                 String? @map("branch_digit") @db.VarChar(5)
  accountNumber               String? @map("account_number") @db.VarChar(30)
  accountDigit                String? @map("account_digit") @db.VarChar(5)
  /// Agência+conta sem máscara — detecta duplicidade real entre formatos diferentes.
  normalizedAccountIdentifier String? @map("normalized_account_identifier")

  holderName               String?   @map("holder_name")
  holderDocument           String?   @map("holder_document")
  normalizedHolderDocument String?   @map("normalized_holder_document")
  /// Conta cujo titular não é a empresa: exige justificativa, permissão e auditoria.
  isThirdParty             Boolean   @default(false) @map("is_third_party")
  thirdPartyReason         String?   @map("third_party_reason")
  thirdPartyApprovedBy     String?   @map("third_party_approved_by") @db.Uuid
  thirdPartyApprovedAt     DateTime? @map("third_party_approved_at")

  /// Dados de conta internacional e convênios de cobrança (seção 13).
  country         String? @db.VarChar(2)
  swiftCode       String? @map("swift_code") @db.VarChar(20)
  iban            String? @db.VarChar(40)
  agreementNumber String? @map("agreement_number") @db.VarChar(30)
  bankClientCode  String? @map("bank_client_code") @db.VarChar(30)
  walletNumber    String? @map("wallet_number") @db.VarChar(20)
  walletVariation String? @map("wallet_variation") @db.VarChar(20)
  assignorCode    String? @map("assignor_code") @db.VarChar(30)
  bankNotes       String? @map("bank_notes")

  /// Campos exclusivos de caixa, fundo fixo e carteira (seção 15).
  physicalLocation     String? @map("physical_location")
  responsibleUserId    String? @map("responsible_user_id") @db.Uuid
  requiresDailyClosing Boolean @default(false) @map("requires_daily_closing")
  checkFrequencyDays   Int?    @map("check_frequency_days")

  currencyCode String @default("BRL") @map("currency_code") @db.VarChar(3)

  isPrimary             Boolean @default(false) @map("is_primary")
  isDefaultForPayments  Boolean @default(false) @map("is_default_for_payments")
  isDefaultForReceipts  Boolean @default(false) @map("is_default_for_receipts")
  isDefaultForTaxes     Boolean @default(false) @map("is_default_for_taxes")
  isDefaultForPayroll   Boolean @default(false) @map("is_default_for_payroll")
  isDefaultForTransfers Boolean @default(false) @map("is_default_for_transfers")

  allowsNegativeBalance    Boolean @default(false) @map("allows_negative_balance")
  allowsManualEntries      Boolean @default(true) @map("allows_manual_entries")
  allowsImports            Boolean @default(true) @map("allows_imports")
  allowsIntegrations       Boolean @default(false) @map("allows_integrations")
  allowsRetroactiveEntries Boolean @default(false) @map("allows_retroactive_entries")
  requiresAttachment       Boolean @default(false) @map("requires_attachment")
  requiresHistory          Boolean @default(false) @map("requires_history")
  requiresCategory         Boolean @default(true) @map("requires_category")

  reconciliationMode ReconciliationMode @default(MANUAL) @map("reconciliation_mode")

  /// Categorias sugeridas para os lançamentos automáticos da conta (seção 17).
  feeCategoryId            String? @map("fee_category_id") @db.Uuid
  interestPaidCategoryId   String? @map("interest_paid_category_id") @db.Uuid
  interestEarnedCategoryId String? @map("interest_earned_category_id") @db.Uuid
  iofCategoryId            String? @map("iof_category_id") @db.Uuid
  yieldCategoryId          String? @map("yield_category_id") @db.Uuid
  transferCategoryId       String? @map("transfer_category_id") @db.Uuid
  investmentCategoryId     String? @map("investment_category_id") @db.Uuid
  redemptionCategoryId     String? @map("redemption_category_id") @db.Uuid
  reversalCategoryId       String? @map("reversal_category_id") @db.Uuid

  /// Saldos mínimos/máximos recomendados — referência de gestão, não trava operacional.
  minimumRecommendedBalance Decimal? @map("minimum_recommended_balance") @db.Decimal(18, 2)
  maximumRecommendedBalance Decimal? @map("maximum_recommended_balance") @db.Decimal(18, 2)
  blockedBalance            Decimal? @map("blocked_balance") @db.Decimal(18, 2)

  startDate         DateTime? @map("start_date") @db.Date
  closingDate       DateTime? @map("closing_date") @db.Date
  /// Saldo declarado no encerramento, exigido pela seção 34.
  closingBalance    Decimal?  @map("closing_balance") @db.Decimal(18, 2)
  closingReason     String?   @map("closing_reason")
  closingDocumentId String?   @map("closing_document_id") @db.Uuid

  status FinancialAccountStatus @default(DRAFT)
  notes  String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialInstitution FinancialInstitution?   @relation(fields: [financialInstitutionId], references: [id])
  businessUnit         BusinessUnit?           @relation(fields: [businessUnitId], references: [id])
  costCenter           CostCenter?             @relation(fields: [costCenterId], references: [id])
  accountPlan          FinancialAccountPlan?   @relation("FinancialAccountPlanLink", fields: [accountPlanId], references: [id])
  financialNature      FinancialNatureCatalog? @relation("FinancialAccountNature", fields: [financialNatureId], references: [id])

  openingBalances FinancialAccountOpeningBalance[]
  limits          FinancialAccountLimit[]
  pixKeys         CompanyPixKey[]
  users           FinancialAccountUser[]
  integrations    FinancialAccountIntegration[]
  cards           CorporateCard[]
  statusHistory   FinancialAccountStatusHistory[]
  receiptMethods  ReceiptMethod[]                  @relation("ReceiptMethodDefaultAccount")

  treasuryPrimaryFor TreasurySettings[] @relation("TreasuryPrimaryAccount")
  treasuryPaymentFor TreasurySettings[] @relation("TreasuryPaymentAccount")
  treasuryReceiptFor TreasurySettings[] @relation("TreasuryReceiptAccount")
  treasuryTaxFor     TreasurySettings[] @relation("TreasuryTaxAccount")
  treasuryPayrollFor TreasurySettings[] @relation("TreasuryPayrollAccount")
  treasuryCashFor    TreasurySettings[] @relation("TreasuryCashAccount")

  @@unique([companyId, internalCode])
  @@index([organizationId])
  @@index([companyId, status])
  @@index([normalizedAccountIdentifier])
  @@map("financial_accounts")
}

/// Saldo de implantação. Alterações depois de existir movimentação exigem justificativa e
/// preservam o registro anterior como `SUPERSEDED` — o histórico nunca é sobrescrito.
model FinancialAccountOpeningBalance {
  id                 String @id @default(uuid()) @db.Uuid
  financialAccountId String @map("financial_account_id") @db.Uuid

  balanceDate          DateTime    @map("balance_date") @db.Date
  balanceAmount        Decimal     @map("balance_amount") @db.Decimal(18, 2)
  balanceType          BalanceType @default(CREDIT) @map("balance_type")
  source               String?
  documentAttachmentId String?     @map("document_attachment_id") @db.Uuid
  reason               String?

  status OpeningBalanceStatus @default(APPROVED)

  createdBy  String?   @map("created_by") @db.Uuid
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([financialAccountId, status])
  @@map("financial_account_opening_balances")
}

/// Limite contratado com o banco (cheque especial, conta garantida, capital de giro).
