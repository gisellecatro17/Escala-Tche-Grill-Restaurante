/// Forma de pagamento configurável, com as exigências de cada meio (seções 41 e 42).
///
/// O nome carrega o sufixo `Catalog` porque `enum PaymentMethod` já existe e é usado
/// por fornecedores e clientes — mesmo motivo de `FinancialNatureCatalog`. A tabela
/// continua sendo `payment_methods`.
model PaymentMethodCatalog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// Nulo = forma compartilhada por toda a organização.
  companyId      String? @map("company_id") @db.Uuid

  code        String            @db.VarChar(30)
  name        String
  description String?
  methodType  PaymentMethodType @map("method_type")

  requiresFinancialAccount Boolean @default(true) @map("requires_financial_account")
  requiresBeneficiary      Boolean @default(false) @map("requires_beneficiary")
  requiresBankData         Boolean @default(false) @map("requires_bank_data")
  requiresPixKey           Boolean @default(false) @map("requires_pix_key")
  requiresBarcode          Boolean @default(false) @map("requires_barcode")
  requiresDigitableLine    Boolean @default(false) @map("requires_digitable_line")
  requiresAttachment       Boolean @default(false) @map("requires_attachment")
  requiresApproval         Boolean @default(false) @map("requires_approval")

  allowsScheduling   Boolean @default(true) @map("allows_scheduling")
  allowsInstallments Boolean @default(false) @map("allows_installments")
  allowsRecurrence   Boolean @default(false) @map("allows_recurrence")
  allowsIntegration  Boolean @default(false) @map("allows_integration")
  allowsBatchPayment Boolean @default(false) @map("allows_batch_payment")

  /// Valor a partir do qual a forma exige confirmação adicional (seção 42).
  confirmationThreshold Decimal? @map("confirmation_threshold") @db.Decimal(18, 2)
  settlementDays        Int      @default(0) @map("settlement_days")

  defaultFeeCategoryId String? @map("default_fee_category_id") @db.Uuid

  sortOrder Int          @default(0) @map("sort_order")
  status    RecordStatus @default(ACTIVE)
  isSystem  Boolean      @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultFeeCategory FinancialCategory? @relation("PaymentMethodFeeCategory", fields: [defaultFeeCategoryId], references: [id])

  @@unique([organizationId, companyId, code])
  @@index([organizationId])
  @@map("payment_methods")
}

/// Forma de recebimento, com taxas e prazos de compensação (seções 43 e 44).
/// As taxas são apenas cadastradas: o cálculo virá com o Contas a Receber.
model ReceiptMethod {
  id             String  @id @default(uuid()) @db.Uuid
