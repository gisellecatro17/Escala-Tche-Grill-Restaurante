  CREDIT_CARD
  DEBIT_CARD
  CASH
  CHECK
  PAYMENT_LINK
  DIRECT_DEBIT
  ACCOUNT_CREDIT
  DEPOSIT
  GATEWAY
  MARKETPLACE
  OTHER

  @@map("receipt_method_type")
