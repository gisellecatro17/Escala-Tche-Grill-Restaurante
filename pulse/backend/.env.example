# Porta em que a API do Pulse é servida
PORT=3333

# Ambiente de execução
NODE_ENV=development

# String de conexão do PostgreSQL usada pelo Prisma
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse?schema=public"

# URL do projeto Supabase e chaves de API (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chave de serviço (nunca exposta ao front-end) — usada para validar tokens e operações administrativas
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Origem(ns) permitidas para CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Bucket do Supabase Storage usado para logos de empresas (e demais anexos futuros).
# Crie este bucket como público no painel do Supabase (Storage > New bucket).
SUPABASE_STORAGE_BUCKET=pulse-public

# Consulta cadastral de CNPJ (seção 16 do prompt mestre "Cadastro de Empresas").
# mock (padrão): dados simulados, sem chamadas externas — ideal para desenvolvimento/testes.
# brasilapi: usa a BrasilAPI (https://brasilapi.com.br), API pública sem necessidade de chave.
COMPANY_REGISTRY_PROVIDER=mock
COMPANY_REGISTRY_API_URL=https://brasilapi.com.br/api/cnpj/v1
COMPANY_REGISTRY_API_KEY=

# Consulta de CEP.
# viacep (padrão): usa o ViaCEP (https://viacep.com.br), sem necessidade de chave.
# mock: dados simulados, sem chamadas externas.
POSTAL_CODE_PROVIDER=viacep
POSTAL_CODE_API_URL=https://viacep.com.br/ws

# ── Tesouraria ───────────────────────────────────────────────────────────────
# O campo `credentials_reference` das integrações bancárias guarda um PONTEIRO para o
# cofre de segredos (ex.: "vault://pulse/company/<id>/bb"), nunca a credencial em si.
# Nenhuma integração real é feita nesta etapa, então o back-end ainda não lê estas
# variáveis — elas ficam comentadas para documentar o que será necessário quando o
# resolvedor de segredos entrar. Nunca coloque a credencial no banco.
# TREASURY_VAULT_PROVIDER=none
# TREASURY_VAULT_URL=
# TREASURY_VAULT_TOKEN=
